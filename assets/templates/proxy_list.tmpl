        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <script>
        const HY2_INSTALL_SCRIPT = `curl -fsSL https://raw.githubusercontent.com/tanaer/port-forward/refs/heads/master/scripts/install.sh | bash`;

        // 落地配置列表数据（JSON序列化确保安全）
        const outboundListData = [];
        {{range .outboundList}}
        outboundListData.push({
            id: {{.Id}},
            name: {{printf "%q" .Name}},
            type: {{printf "%q" .Type}},
            hy2Server: {{printf "%q" .Hy2Server}},
            hy2Port: {{printf "%q" .Hy2Port}},
            vmessServer: {{printf "%q" .VmessServer}},
            vmessPort: {{.VmessPort}},
            socks5Addr: {{printf "%q" .Socks5Addr}},
            socks5Port: {{.Socks5Port}}
        });
        {{end}}

        // 根据落地配置ID获取名称
        function getOutboundNameById(id) {
            if (!id) return null;
            const config = outboundListData.find(c => c.id === id);
            return config ? config.name : null;
        }

        // 根据落地配置ID获取服务器地址
        function getOutboundServerById(id) {
            if (!id) return null;
            const config = outboundListData.find(c => c.id === id);
            if (!config) return null;
            switch (config.type) {
                case 'hysteria2': return config.hy2Server + ':' + config.hy2Port;
                case 'vmess': return config.vmessServer + ':' + config.vmessPort;
                case 'socks5': return config.socks5Addr + ':' + config.socks5Port;
                default: return null;
            }
        }

        // 复制出站地址
        function copyOutboundAddr(btn) {
            const addrCode = btn.parentElement.querySelector('.outbound-addr');
            if (!addrCode) return;
            const text = addrCode.textContent.trim();
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    btn.textContent = '✓';
                    btn.style.color = '#28a745';
                    setTimeout(() => {
                        btn.textContent = '📋';
                        btn.style.color = '#6c757d';
                    }, 1500);
                }).catch(() => {
                    fallbackCopyAddr(text, btn);
                });
            } else {
                fallbackCopyAddr(text, btn);
            }
        }

        function fallbackCopyAddr(text, btn) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                btn.textContent = '✓';
                btn.style.color = '#28a745';
                setTimeout(() => {
                    btn.textContent = '📋';
                    btn.style.color = '#6c757d';
                }, 1500);
            } catch (e) {
                alert('复制失败');
            }
            document.body.removeChild(textarea);
        }

        function copyHy2InstallScript(btn) {
            if (!btn) return;
            const originalText = btn.textContent || '复制命令';
            const onSuccess = () => {
                btn.textContent = '已复制';
                btn.classList.add('copied');
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.classList.remove('copied');
                }, 1500);
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(HY2_INSTALL_SCRIPT).then(onSuccess).catch(() => {
                    if (fallbackCopyText(HY2_INSTALL_SCRIPT)) {
                        onSuccess();
                    } else {
                        alert('复制失败，请手动复制命令');
                    }
                });
            } else {
                if (fallbackCopyText(HY2_INSTALL_SCRIPT)) {
                    onSuccess();
                } else {
                    alert('复制失败，请手动复制命令');
                }
            }
        }

        function fallbackCopyText(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            let success = false;
            try {
                success = document.execCommand('copy');
            } catch (e) {
                success = false;
            }
            document.body.removeChild(textarea);
            return success;
        }

        // 填充落地配置名称
        function populateOutboundNames() {
            document.querySelectorAll('.outbound-name[data-outbound-id]').forEach(el => {
                const id = parseInt(el.dataset.outboundId, 10);
                if (id) {
                    const name = getOutboundNameById(id);
                    const nameSpan = el.querySelector('.outbound-name-text');
                    if (nameSpan && name) {
                        nameSpan.textContent = name;
                    }
                }
            });
        }

        const proxyQualityCache = {};
        const proxyTrafficTrendCache = {};
        let currentQualityModalId = null;
        document.addEventListener('DOMContentLoaded', () => {
            const qualityForm = document.getElementById('quality-config-form');
            if (qualityForm) {
                qualityForm.addEventListener('submit', saveQualityConfig);
            }
            loadProxyMetrics();
            initQualityModalEvents();
            populateOutboundNames(); // 填充落地配置名称
        });

        async function saveQualityConfig(event) {
            event.preventDefault();
            const tip = document.getElementById('quality-save-tip');
            tip.textContent = '保存中...';

            const formData = new FormData(event.target);
            formData.append('enabled', document.getElementById('quality-enabled').checked ? '1' : '0');

            try {
                const response = await fetch('/proxy/quality-config', {
                    method: 'POST',
                    body: formData,
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || '保存失败');
                }
                tip.style.color = '#28a745';
                tip.textContent = '✅ 配置已更新';
                const statusEl = document.querySelector('.quality-status');
                if (statusEl) {
                    statusEl.textContent = data.running ? '运行中' : '未运行';
                    statusEl.className = 'quality-status ' + (data.running ? 'enabled' : 'disabled');
                }
            } catch (error) {
                tip.style.color = '#dc3545';
                tip.textContent = '❌ ' + error.message;
            } finally {
                setTimeout(() => {
                    tip.textContent = '';
                    tip.style.color = '#555';
                }, 3000);
            }
        }

        async function loadProxyMetrics() {
            const rows = document.querySelectorAll('tbody tr[data-proxy-id]');
            if (!rows.length) return;
            const batchSize = 10;
            const ids = Array.from(rows).map(row => row.getAttribute('data-proxy-id'));
            for (let i = 0; i < ids.length; i += batchSize) {
                const chunk = ids.slice(i, i + batchSize);
                await Promise.all(chunk.map(async (id) => {
                    if (!id) return;
                    try {
                        const response = await fetch(`/proxy/quality/${id}?limit=5&resolution=minute`);
                        const data = await response.json();
                        if (!response.ok) {
                            throw new Error(data.error || '加载失败');
                        }
                        proxyQualityCache[id] = data;
                        const samples = (data.samples || {});
                        const qualitySamples = samples.quality || [];
                        const latestQualitySample = qualitySamples.length ? qualitySamples[qualitySamples.length - 1] : null;
                        const latestStatus = (latestQualitySample && latestQualitySample.Status) || (data.latest && data.latest.Status) || null;
                        updateLatencyBadge(id, latestQualitySample, data.latest || null);
                        const fallbackTraffic = (data.proxy && (data.proxy.TodayTraffic || data.proxy.TotalTraffic)) || getRowTodayTraffic(id);
                        updateTrafficBadge(id, samples.traffic || [], fallbackTraffic, latestStatus);
                    } catch (error) {
                        console.warn('加载线路状态失败', id, error);
                        updateLatencyBadge(id, null, null);
                        updateTrafficBadge(id, [], getRowTodayTraffic(id), null);
                    }
                }));
            }
        }

        function updateLatencyBadge(id, sample, fallbackLog) {
            const latencyEl = document.getElementById(`latency-${id}`);
            const statusEl = document.getElementById(`latency-status-${id}`);
            if (!latencyEl || !statusEl) return;
            let data = sample;
            if (!data && fallbackLog) {
                data = {
                    LatencyMs: fallbackLog.LatencyAvgMs,
                    Status: fallbackLog.Status,
                };
            }
            if (!data) {
                latencyEl.textContent = '-';
                latencyEl.className = 'latency';
                statusEl.className = 'latency-dot';
                statusEl.title = '';
                return;
            }
            const latency = typeof data.LatencyMs === 'number' ? data.LatencyMs : '-';
            latencyEl.textContent = latency === '-' ? '-' : `${latency}ms`;
            latencyEl.className = 'latency ' + classifyLatency(latency);
            const status = data.Status ? data.Status.toLowerCase() : '';
            statusEl.className = `latency-dot${status ? ' ' + status : ''}`;
            statusEl.title = data.Status || '';
        }

        function updateTrafficBadge(id, samples, fallbackTotal, status) {
            const pill = document.getElementById(`traffic-${id}`);
            if (!pill) return;
            let text = '0 B';
            if (fallbackTotal && fallbackTotal.trim() !== '') {
                text = fallbackTotal.trim();
            } else if (samples.length) {
                const latest = samples[samples.length - 1];
                const totalBytes = (latest.BytesUp || 0) + (latest.BytesDown || 0);
                text = formatBytesHuman(totalBytes);
            }
            pill.textContent = text;
            const statusClass = status ? status.toLowerCase() : '';
            pill.className = `traffic-pill${statusClass ? ' ' + statusClass : ''}`;
        }

        function getRowTodayTraffic(id) {
            const row = document.querySelector(`tr[data-proxy-id="${id}"]`);
            if (!row) return '';
            return row.getAttribute('data-today-traffic') || row.getAttribute('data-total-traffic') || '';
        }

        function classifyLatency(latency) {
            if (typeof latency !== 'number') return '';
            if (latency < 100) return 'good';
            if (latency < 300) return 'medium';
            return 'bad';
        }

        function handleTrafficPillKey(event, id) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                openQualityModal(id);
            }
        }

        function openQualityModal(id) {
            currentQualityModalId = id;
            const modal = document.getElementById('quality-modal');
            if (!modal) return;
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
            const row = document.querySelector(`tr[data-proxy-id="${id}"]`);
            const fallbackName = row ? row.dataset.proxyName || `线路 #${id}` : `线路 #${id}`;
            document.getElementById('quality-modal-title').textContent = fallbackName;
            document.getElementById('quality-modal-subtitle').textContent = `线路ID ${id}`;
            setQualityModalError('');
            setQualityModalLoading(true);

            // 初始化ECharts图表
            initECharts();

            if (proxyQualityCache[id]) {
                populateQualityModal(proxyQualityCache[id], fallbackName);
            } else {
                resetQualityModalMetrics();
            }
            fetchQualityDetail(id, fallbackName);
            updateQualityChart(id);
        }

        async function fetchQualityDetail(id, fallbackName) {
            try {
                const response = await fetch(`/proxy/quality/${id}?limit=60&resolution=minute`);
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || '加载失败');
                }
                proxyQualityCache[id] = data;
                populateQualityModal(data, fallbackName);
                setQualityModalLoading(false);
            } catch (error) {
                setQualityModalLoading(false);
                setQualityModalError(error.message || '加载失败');
            }
        }

        function closeQualityModal() {
            const modal = document.getElementById('quality-modal');
            if (!modal) return;
            modal.classList.remove('show');
            document.body.style.overflow = '';
            setQualityModalError('');
            setQualityModalLoading(false);

            // 销毁图表实例
            if (qualityChart) {
                qualityChart.dispose();
                qualityChart = null;
            }
        }

        function initQualityModalEvents() {
            const modal = document.getElementById('quality-modal');
            if (!modal) return;

            // 关闭按钮点击事件
            const closeBtn = modal.querySelector('.quality-modal-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', closeQualityModal);
            }

            // 点击背景关闭
            modal.addEventListener('click', (event) => {
                if (event.target === modal) {
                    closeQualityModal();
                }
            });

            // ESC键关闭
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal.classList.contains('show')) {
                    closeQualityModal();
                }
            });
        }

        function resetQualityModalMetrics() {
            const ids = ['latency', 'jitter', 'loss', 'traffic'];
            ids.forEach(id => {
                const el = document.getElementById(`metric-${id}`);
                if (el) el.textContent = '-';
            });
            const samples = document.getElementById('quality-modal-samples');
            const logs = document.getElementById('quality-modal-logs');
            if (samples) samples.innerHTML = '<div class="quality-modal-empty">暂无采样数据</div>';
            if (logs) logs.innerHTML = '<div class="quality-modal-empty">暂无巡检日志</div>';
            resetTrafficTrendChart();
        }

        function setQualityModalLoading(isLoading) {
            const hint = document.getElementById('quality-modal-loading');
            if (!hint) return;
            hint.style.display = isLoading ? 'inline-block' : 'none';
        }

        function setQualityModalError(message) {
            const el = document.getElementById('quality-modal-error');
            if (!el) return;
            if (message) {
                el.style.display = 'block';
                el.textContent = `⚠️ ${message}`;
            } else {
                el.style.display = 'none';
                el.textContent = '';
            }
        }

        function populateQualityModal(data, fallbackName) {
            if (!data) return;
            const proxy = data.proxy || {};
            const name = proxy.Name || fallbackName || `线路 #${proxy.Id || ''}`;
            document.getElementById('quality-modal-title').textContent = name;
            document.getElementById('quality-modal-subtitle').textContent = `线路ID ${proxy.Id || currentQualityModalId || ''}`;

            const qualitySamples = (data.samples && data.samples.quality) || [];
            const trafficSamples = (data.samples && data.samples.traffic) || [];
            const latestQuality = qualitySamples.length ? qualitySamples[qualitySamples.length - 1] : (data.latest || null);
            const latestTraffic = trafficSamples.length ? trafficSamples[trafficSamples.length - 1] : null;

            const latencyEl = document.getElementById('metric-latency');
            const jitterEl = document.getElementById('metric-jitter');
            const lossEl = document.getElementById('metric-loss');
            const trafficEl = document.getElementById('metric-traffic');

            if (latencyEl) latencyEl.textContent = latestQuality && typeof latestQuality.LatencyMs === 'number' ? `${latestQuality.LatencyMs} ms` : '暂无';
            if (jitterEl) jitterEl.textContent = latestQuality && typeof latestQuality.JitterMs === 'number' ? `${latestQuality.JitterMs} ms` : '暂无';
            if (lossEl) lossEl.textContent = latestQuality && typeof latestQuality.LossPct === 'number' ? `${latestQuality.LossPct.toFixed(1)} %` : '暂无';
            if (trafficEl) {
                if (proxy.TodayTraffic) {
                    trafficEl.textContent = proxy.TodayTraffic;
                } else if (proxy.TotalTraffic) {
                    trafficEl.textContent = proxy.TotalTraffic;
                } else {
                    trafficEl.textContent = '暂无';
                }
            }

            renderQualityModalSamples(qualitySamples, trafficSamples);
            renderQualityModalLogs(data.logs || []);
            setQualityModalError('');
        }

        function renderQualityModalSamples(qualitySamples, trafficSamples) {
            const tbody = document.getElementById('quality-table-body');
            if (!tbody) return;
            const rows = mergeSampleRows(qualitySamples, trafficSamples);
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="data-empty">暂无数据</td></tr>';
                return;
            }
            const body = rows.map(row => {
                const latency = row.quality && typeof row.quality.LatencyMs === 'number' ? `${row.quality.LatencyMs}` : null;
                const jitter = row.quality && typeof row.quality.JitterMs === 'number' ? `${row.quality.JitterMs}` : null;
                const loss = row.quality && typeof row.quality.LossPct === 'number' ? `${row.quality.LossPct.toFixed(1)}` : null;
                let trafficText = '-';
                if (row.traffic) {
                    const up = formatBytesHuman(row.traffic.BytesUp);
                    const down = formatBytesHuman(row.traffic.BytesDown);
                    trafficText = `${up} ↑ / ${down} ↓`;
                }
                const safeTraffic = escapeHtml(trafficText);
                const minuteText = escapeHtml(formatModalTime(row.minute));
                const status = (row.quality && row.quality.Status) || '-';
                const statusClass = status.toLowerCase();
                return `
                    <tr data-minute="${escapeHtml(row.minute)}" data-latency="${latency !== null ? latency : ''}" data-jitter="${jitter !== null ? jitter : ''}" data-loss="${loss !== null ? loss : ''}" data-traffic="${escapeHtml(trafficText)}" data-status="${escapeHtml(status)}" onclick="handleTableRowClick(this)">
                        <td>${minuteText}</td>
                        <td>${safeTraffic}</td>
                        <td>${latency !== null ? latency + ' ms' : '-'}</td>
                        <td>${jitter !== null ? jitter + ' ms' : '-'}</td>
                        <td>${loss !== null ? loss + ' %' : '-'}</td>
                        <td><span class="status-badge ${statusClass}">${escapeHtml(status)}</span></td>
                    </tr>
                `;
            }).join('');
            tbody.innerHTML = body;
        }

        function handleTableRowClick(row) {
            // 移除之前选中行的样式
            document.querySelectorAll('#quality-table-body tr').forEach(r => {
                r.classList.remove('table-row-active');
            });

            // 添加当前选中行的样式
            row.classList.add('table-row-active');

            // 获取数据
            const minute = row.dataset.minute;
            const latency = row.dataset.latency;
            const jitter = row.dataset.jitter;
            const loss = row.dataset.loss;
            const traffic = row.dataset.traffic;
            const status = row.dataset.status;

            // 可以在这里添加显示详细信息的逻辑
            console.log('选中数据:', {
                time: minute,
                latency: latency,
                jitter: jitter,
                loss: loss,
                traffic: traffic,
                status: status
            });
        }

        function mergeSampleRows(qualitySamples, trafficSamples) {
            const map = new Map();
            (qualitySamples || []).forEach(sample => {
                const key = normalizeMinuteKey(sample.Minute);
                map.set(key, { minute: key, quality: sample });
            });
            (trafficSamples || []).forEach(sample => {
                const key = normalizeMinuteKey(sample.Minute);
                const row = map.get(key) || { minute: key };
                row.traffic = sample;
                map.set(key, row);
            });
            const rows = Array.from(map.values()).sort((a, b) => {
                const tA = Date.parse(a.minute) || 0;
                const tB = Date.parse(b.minute) || 0;
                return tB - tA; // 倒序排列，最新的在前
            });
            const limit = 12;
            // 倒序后取前12条（最新的12条）
            return rows.slice(0, limit);
        }

        function renderQualityModalLogs(logs) {
            const container = document.getElementById('quality-modal-logs');
            if (!container) return;
            if (!logs.length) {
                container.innerHTML = '<div class="quality-modal-empty">暂无巡检日志</div>';
                return;
            }
            const head = `
                <table>
                    <thead>
                        <tr>
                            <th>时间</th>
                            <th>状态</th>
                            <th>延迟</th>
                            <th>丢包</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            const rows = logs.slice(0, 12).map(log => `
                <tr>
                    <td>${escapeHtml(formatModalTime(log.CreatedAt))}</td>
                    <td>${escapeHtml(log.Status || '-')}</td>
                    <td>${typeof log.LatencyAvgMs === 'number' ? log.LatencyAvgMs + ' ms' : '-'}</td>
                    <td>${typeof log.LossPercent === 'number' ? log.LossPercent.toFixed(1) + ' %' : '-'}</td>
                    <td>${escapeHtml(log.Message || '-')}</td>
                </tr>
            `).join('');
            container.innerHTML = head + rows + '</tbody></table>';
        }

        let qualityChart = null;
        let currentTimeRange = '30d';

        function initECharts() {
            const chartDom = document.getElementById('quality-chart');
            if (!chartDom) return null;

            // 如果图表已存在，则销毁
            if (qualityChart) {
                qualityChart.dispose();
            }

            qualityChart = echarts.init(chartDom);

            // 时间范围选择器事件
            document.querySelectorAll('.range-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentTimeRange = this.dataset.range;
                    if (currentQualityModalId) {
                        updateQualityChart(currentQualityModalId);
                    }
                });
            });

            return qualityChart;
        }

        function updateQualityChart(proxyId) {
            if (!qualityChart) {
                qualityChart = initECharts();
            }

            if (!qualityChart) return;

            let resolution = 'daily';
            let limit = 30;

            if (currentTimeRange === '24h') {
                resolution = 'hourly';
                limit = 24;
            } else if (currentTimeRange === '7d') {
                resolution = 'daily';
                limit = 7;
            } else {
                resolution = 'daily';
                limit = 30;
            }

            fetch(`/proxy/quality/${proxyId}?resolution=${resolution}&limit=${limit}`)
                .then(response => response.json())
                .then(data => {
                    renderQualityChart(data.samples || {});
                })
                .catch(error => {
                    console.error('Failed to load chart data:', error);
                    renderQualityChart({});
                });
        }

        // 填充完整时间范围
        function fillCompleteTimeRange(dataMap, timeRange) {
            const result = new Map(dataMap);
            const now = new Date();
            const emptyEntry = { quality: null, traffic: null };

            if (timeRange === '24h') {
                // 填充最近24小时（按小时）
                for (let i = 0; i < 24; i++) {
                    const time = new Date(now);
                    time.setHours(now.getHours() - (23 - i));
                    time.setMinutes(0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            } else if (timeRange === '7d') {
                // 填充最近7天（按天）
                for (let i = 0; i < 7; i++) {
                    const time = new Date(now);
                    time.setDate(now.getDate() - (6 - i));
                    time.setHours(0, 0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            } else if (timeRange === '30d') {
                // 填充最近30天（按天）
                for (let i = 0; i < 30; i++) {
                    const time = new Date(now);
                    time.setDate(now.getDate() - (29 - i));
                    time.setHours(0, 0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            }

            return result;
        }

        // 将时间截断到指定粒度（小时或天）
        function truncateTime(timeStr, granularity) {
            const date = new Date(timeStr);
            if (isNaN(date.getTime())) return timeStr;

            if (granularity === 'hour') {
                date.setMinutes(0, 0, 0);
            } else if (granularity === 'day') {
                date.setHours(0, 0, 0, 0);
            }
            return date.toISOString();
        }

        // 聚合quality数据（按小时或天）
        function aggregateQualityData(qualityData, granularity) {
            const aggregated = new Map();

            qualityData.forEach(item => {
                const time = item.Minute || '';
                const truncatedTime = truncateTime(time, granularity);

                if (!aggregated.has(truncatedTime)) {
                    aggregated.set(truncatedTime, {
                        latencySum: 0,
                        latencyCount: 0,
                        lossSum: 0,
                        lossCount: 0
                    });
                }

                const agg = aggregated.get(truncatedTime);
                if (typeof item.LatencyMs === 'number') {
                    agg.latencySum += item.LatencyMs;
                    agg.latencyCount++;
                }
                if (typeof item.LossPct === 'number') {
                    agg.lossSum += item.LossPct;
                    agg.lossCount++;
                }
            });

            // 计算平均值
            const result = new Map();
            aggregated.forEach((agg, time) => {
                result.set(time, {
                    LatencyMs: agg.latencyCount > 0 ? agg.latencySum / agg.latencyCount : null,
                    LossPct: agg.lossCount > 0 ? agg.lossSum / agg.lossCount : null
                });
            });

            return result;
        }

        function renderQualityChart(samples) {
            if (!qualityChart) return;

            const qualityData = samples.quality || [];
            const trafficData = samples.traffic || [];

            console.log('Quality data:', qualityData);
            console.log('Traffic data:', trafficData);

            // 处理时间轴
            const timeLabels = [];
            const latencyData = [];
            const lossData = [];
            const upData = [];
            const downData = [];
            const totalData = [];

            // 根据时间范围确定聚合粒度
            let granularity = 'hour';
            if (currentTimeRange === '7d' || currentTimeRange === '30d') {
                granularity = 'day';
            }

            // 先聚合quality数据
            const aggregatedQuality = aggregateQualityData(qualityData, granularity);

            // 合并数据（以traffic数据的时间为基准）
            const mergedData = new Map();

            // 先添加traffic数据
            trafficData.forEach(item => {
                const time = item.Minute || '';
                const truncatedTime = truncateTime(time, granularity);
                mergedData.set(truncatedTime, {
                    quality: aggregatedQuality.get(truncatedTime) || null,
                    traffic: item
                });
            });

            // 添加没有traffic数据但有quality数据的时间点
            aggregatedQuality.forEach((quality, time) => {
                if (!mergedData.has(time)) {
                    mergedData.set(time, { quality: quality, traffic: null });
                }
            });

            // 填充完整时间范围
            const filledData = fillCompleteTimeRange(mergedData, currentTimeRange);

            // 排序并提取数据 - 按时间正序排列（从旧到新）
            const sortedEntries = Array.from(filledData.entries()).sort((a, b) => {
                const timeA = a[0] || '';
                const timeB = b[0] || '';
                return new Date(timeA) - new Date(timeB);
            });

            sortedEntries.forEach(([time, data]) => {
                const displayTime = formatChartTime(time);
                timeLabels.push(displayTime);

                // 延迟数据
                latencyData.push(data.quality && typeof data.quality.LatencyMs === 'number'
                    ? parseFloat(data.quality.LatencyMs.toFixed(0)) : null);

                // 丢包数据
                lossData.push(data.quality && typeof data.quality.LossPct === 'number'
                    ? parseFloat(data.quality.LossPct.toFixed(1)) : null);

                // 流量数据
                if (data.traffic) {
                    const up = parseFloat(((data.traffic.BytesUp || 0) / (1024 * 1024)).toFixed(2));
                    const down = parseFloat(((data.traffic.BytesDown || 0) / (1024 * 1024)).toFixed(2));
                    upData.push(up);
                    downData.push(down);
                    totalData.push(up + down);
                } else {
                    upData.push(0);
                    downData.push(0);
                    totalData.push(0);
                }
            });

            console.log('Processed data:', {
                timeLabels,
                latencyData,
                lossData,
                upData,
                downData
            });

            // 计算流量最大值用于缩放
            const maxTraffic = Math.max(...totalData, 1);
            const maxLatency = Math.max(...latencyData.filter(v => v !== null), 100);

            const option = {
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'cross',
                        crossStyle: {
                            color: '#999'
                        }
                    },
                    formatter: function(params) {
                        let result = `<strong>${params[0].axisValue}</strong><br/>`;
                        params.forEach(param => {
                            if (param.seriesName.includes('流量')) {
                                result += `${param.marker}${param.seriesName}: ${param.value} MB<br/>`;
                            } else if (param.seriesName.includes('丢包')) {
                                result += `${param.marker}${param.seriesName}: ${param.value}%<br/>`;
                            } else {
                                result += `${param.marker}${param.seriesName}: ${param.value}ms<br/>`;
                            }
                        });
                        return result;
                    }
                },
                legend: {
                    data: ['上行流量', '下行流量', '延迟', '丢包率'],
                    top: 10
                },
                xAxis: [
                    {
                        type: 'category',
                        data: timeLabels,
                        axisPointer: {
                            type: 'shadow'
                        }
                    }
                ],
                yAxis: [
                    {
                        type: 'value',
                        name: '流量 (MB)',
                        position: 'left',
                        axisLabel: {
                            formatter: '{value} MB'
                        },
                        min: 0,
                        max: maxTraffic * 1.2
                    },
                    {
                        type: 'value',
                        name: '延迟 (ms)',
                        position: 'right',
                        axisLabel: {
                            formatter: '{value} ms'
                        },
                        min: 0,
                        max: maxLatency * 1.2
                    }
                ],
                series: [
                    {
                        name: '上行流量',
                        type: 'bar',
                        yAxisIndex: 0,
                        data: upData,
                        itemStyle: {
                            color: '#5470c6'
                        }
                    },
                    {
                        name: '下行流量',
                        type: 'bar',
                        yAxisIndex: 0,
                        data: downData,
                        itemStyle: {
                            color: '#91cc75'
                        }
                    },
                    {
                        name: '延迟',
                        type: 'line',
                        yAxisIndex: 1,
                        data: latencyData,
                        smooth: true,
                        itemStyle: {
                            color: '#ee6666'
                        },
                        lineStyle: {
                            width: 2
                        }
                    },
                    {
                        name: '丢包率',
                        type: 'line',
                        yAxisIndex: 1,
                        data: lossData,
                        smooth: true,
                        itemStyle: {
                            color: '#fac858'
                        },
                        lineStyle: {
                            width: 2
                        }
                    }
                ],
                grid: {
                    left: '3%',
                    right: '4%',
                    bottom: '3%',
                    top: '15%',
                    containLabel: true
                }
            };

            qualityChart.setOption(option, true);
        }

        function normalizeMinuteKey(value) {
            if (!value) return '';
            return value.includes('T') ? value : value.replace(' ', 'T');
        }

        function formatModalTime(value) {
            if (!value) return '-';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            return parsed.toLocaleString();
        }

        function formatTrendLabel(value) {
            if (!value) return '--';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            return `${month}-${day}`;
        }

        function formatTrendTooltipDate(value) {
            if (!value) return '-';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            return parsed.toLocaleDateString();
        }

        function formatChartTime(value) {
            if (!value) return '';

            // 直接解析 ISO 8601 格式的字符串（包含时区）
            const parsed = new Date(value);
            if (isNaN(parsed.getTime())) {
                // 如果解析失败，尝试手动解析
                const timeStr = value.replace('T', ' ').replace('+08:00', '').replace('Z', '');
                const fallbackParsed = new Date(timeStr + ' +08:00');
                if (isNaN(fallbackParsed.getTime())) {
                    return value;
                }
                return formatDateByRange(fallbackParsed, currentTimeRange);
            }

            return formatDateByRange(parsed, currentTimeRange);
        }

        function formatDateByRange(dateObj, range) {
            if (range === '24h') {
                // 24小时视图：显示小时
                return dateObj.getHours().toString().padStart(2, '0') + ':00';
            } else if (range === '7d') {
                // 7天视图：显示月/日 小时
                const month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
                const day = dateObj.getDate().toString().padStart(2, '0');
                const hour = dateObj.getHours().toString().padStart(2, '0');
                return `${month}/${day} ${hour}:00`;
            } else {
                // 30天视图：只显示月/日
                const month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
                const day = dateObj.getDate().toString().padStart(2, '0');
                return `${month}/${day}`;
            }
        }

        function formatTrafficSummary(sample) {
            if (!sample) return '-';
            const total = (sample.BytesUp + sample.BytesDown) / (1024 * 1024);
            return `${total.toFixed(2)} MB`;
        }

        function formatBytesHuman(bytes) {
            if (!bytes || bytes <= 0) return '0 B';
            const units = ['B', 'KB', 'MB', 'GB', 'TB'];
            let idx = 0;
            let value = bytes;
            while (value >= 1024 && idx < units.length - 1) {
                value /= 1024;
                idx++;
            }
            return `${value.toFixed(2)} ${units[idx]}`;
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function testProxy(id) {
            const latencyEl = document.getElementById('latency-' + id);
            const testBtn = document.getElementById('test-btn-' + id);

            // 显示测试中状态
            latencyEl.textContent = '测试中...';
            latencyEl.className = 'latency testing';
            testBtn.textContent = '测试中';
            testBtn.style.opacity = '0.6';
            testBtn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/test/' + id);
                const result = await response.json();

                if (result.success) {
                    latencyEl.textContent = result.rtt;

                    // 根据延迟设置颜色
                    const ms = result.latency / 1000000; // 纳秒转毫秒
                    if (ms < 100) {
                        latencyEl.className = 'latency good';
                    } else if (ms < 300) {
                        latencyEl.className = 'latency medium';
                    } else {
                        latencyEl.className = 'latency bad';
                    }
                } else {
                    latencyEl.textContent = '失败';
                    latencyEl.className = 'latency bad';
                    alert('测试失败: ' + result.message);
                }
            } catch (error) {
                latencyEl.textContent = '错误';
                latencyEl.className = 'latency bad';
                alert('测试出错: ' + error.message);
            } finally {
                // 恢复按钮状态
                testBtn.textContent = '测试';
                testBtn.style.opacity = '1';
                testBtn.style.pointerEvents = 'auto';
            }
        }

