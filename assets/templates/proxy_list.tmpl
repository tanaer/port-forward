        // 显示进度对话框
        function showProgressModal(title, steps) {
            const modal = document.createElement('div');
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            `;

            modal.innerHTML = `
                <div style="background: white; padding: 40px; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 8px 40px rgba(0,0,0,0.4);">
                    <h2 style="margin: 0 0 30px 0; color: #333; font-size: 20px;">${title}</h2>
                    <div id="progressSteps" style="margin-bottom: 30px;"></div>
                    <div style="text-align: center; color: #666; font-size: 14px;">
                        <div id="progressStatus">请稍候，正在执行中...</div>
                        <div id="progressElapsed" style="margin-top: 6px; font-size: 12px; color: #888;"></div>
                    </div>
                </div>
            `;

            // 渲染步骤
            const stepsDiv = modal.querySelector('#progressSteps');
            steps.forEach((step, index) => {
                const stepDiv = document.createElement('div');
                stepDiv.id = `progress-step-${index}`;
                stepDiv.style.cssText = `
                    display: flex;
                    align-items: center;
                    margin-bottom: 15px;
                    padding: 12px 15px;
                    border-radius: 8px;
                    background: #f8f9fa;
                    border-left: 4px solid #dee2e6;
                `;
                stepDiv.innerHTML = `
                    <span style="width: 24px; height: 24px; border-radius: 50%; background: #dee2e6; color: white; display: inline-flex; align-items: center; justify-content: center; margin-right: 15px; font-size: 12px; font-weight: bold;">${index + 1}</span>
                    <span style="color: #666;">${step}</span>
                `;
                stepsDiv.appendChild(stepDiv);
            });

            document.body.appendChild(modal);
            return modal;
        }

        function setProgressStatus(modal, message) {
            const statusEl = modal.querySelector('#progressStatus');
            if (statusEl) {
                statusEl.textContent = message;
            }
        }

        function setProgressElapsed(modal, message) {
            const elapsedEl = modal.querySelector('#progressElapsed');
            if (elapsedEl) {
                elapsedEl.textContent = message || '';
            }
        }

        // 更新进度步骤
        function updateProgressStep(modal, stepIndex) {
            const stepDiv = modal.querySelector(`#progress-step-${stepIndex}`);
            if (stepDiv) {
                stepDiv.style.background = '#e3f2fd';
                stepDiv.style.borderLeftColor = '#2196f3';
                stepDiv.querySelector('span:first-child').style.background = '#2196f3';
            }

            // 隐藏进度步骤并显示完成状态
            if (stepIndex >= 0) {
                const allSteps = modal.querySelectorAll('[id^="progress-step-"]');
                allSteps.forEach((step, index) => {
                    if (index < stepIndex) {
                        step.style.background = '#e8f5e9';
                        step.style.borderLeftColor = '#4caf50';
                        step.querySelector('span:first-child').style.background = '#4caf50';
                        step.querySelector('span:first-child').innerHTML = '✓';
                    } else if (index === stepIndex) {
                        step.style.background = '#fff3e0';
                        step.style.borderLeftColor = '#ff9800';
                        step.querySelector('span:first-child').style.background = '#ff9800';
                    }
                });
            }
        }

        // 隐藏进度对话框
        function hideProgressModal(modal) {
            modal.remove();
        }

        // 测试出站连接
        async function testOutbound(id) {
            const testBtn = document.getElementById('test-btn-' + id);
            const latencyEl = document.getElementById('latency-' + id);

            // 显示测试中状态
            latencyEl.textContent = '测试中...';
            latencyEl.className = 'latency testing';
            testBtn.textContent = '测试中';
            testBtn.style.opacity = '0.6';
            testBtn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/test/' + id);
                const result = await response.json();

                if (result.success) {
                    // 更新RTT列
                    latencyEl.textContent = result.rtt;

                    // 根据延迟设置颜色
                    const ms = result.latency / 1000000; // 纳秒转毫秒
                    if (ms < 100) {
                        latencyEl.className = 'latency good';
                    } else if (ms < 300) {
                        latencyEl.className = 'latency medium';
                    } else {
                        latencyEl.className = 'latency bad';
                    }
                } else {
                    // 更新RTT列显示失败
                    latencyEl.textContent = '失败';
                    latencyEl.className = 'latency bad';
                }
            } catch (error) {
                // 更新RTT列显示错误
                latencyEl.textContent = '错误';
                latencyEl.className = 'latency bad';
            } finally {
                // 恢复按钮状态
                testBtn.textContent = '测试';
                testBtn.style.opacity = '1';
                testBtn.style.pointerEvents = 'auto';
            }
        }

