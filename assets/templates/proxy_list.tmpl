        // 导出选中的代理
        let exportInProgress = false;
        async function exportSelected() {
            const checkedIds = document.querySelectorAll('input[name="proxyIds"]:checked');

            if (checkedIds.length === 0) {
                if (!confirm('未选择任何代理，将导出所有配置。确定继续吗？')) {
                    return;
                }
            }

            if (exportInProgress) {
                return;
            }

            exportInProgress = true;
            const progressModal = showProgressModal('📤 正在导出代理配置', [
                '整理导出列表...',
                '服务器生成文件...',
                '准备下载...',
                '完成'
            ]);
            updateProgressStep(progressModal, 0);
            setProgressStatus(progressModal, '正在整理导出列表...');

            const startTime = Date.now();
            const elapsedTimer = setInterval(() => {
                const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
                setProgressElapsed(progressModal, `已等待 ${formatElapsedSeconds(elapsedSeconds)}`);
            }, 1000);

            try {
                const formData = new FormData();
                if (checkedIds.length > 0) {
                    const ids = Array.from(checkedIds).map(cb => cb.value).join(',');
                    formData.append('ids', ids);
                }

                updateProgressStep(progressModal, 1);
                setProgressStatus(progressModal, '服务器正在生成导出文件...');

                const response = await fetch('/proxy/export', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || '导出失败');
                }

                // 获取JSON数据并触发下载
                updateProgressStep(progressModal, 2);
                setProgressStatus(progressModal, '正在准备下载...');
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = 'proxies_export.json';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                a.remove();

                updateProgressStep(progressModal, 3);
                setProgressStatus(progressModal, '导出完成');
                clearInterval(elapsedTimer);
                exportInProgress = false;
                setTimeout(() => {
                    hideProgressModal(progressModal);
                    alert('导出成功！');
                }, 300);
            } catch (error) {
                exportInProgress = false;
                clearInterval(elapsedTimer);
                hideProgressModal(progressModal);
                alert('导出出错: ' + error.message);
            }
        }

