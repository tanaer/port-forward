<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>代理管理 - goForward</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px; }
        .container { max-width: 1680px; width: 96%; margin: 0 auto; background: white; padding: 30px 40px; border-radius: 12px; box-shadow: 0 2px 14px rgba(0,0,0,0.08); }
        h1 { color: #333; margin-bottom: 10px; }

        /* 统一导航栏样式 */
        .top-nav {
            background: white;
            padding: 15px 30px;
            margin: -30px -30px 30px -30px;
            border-radius: 8px 8px 0 0;
            border-bottom: 2px solid #e9ecef;
            display: flex;
            gap: 15px;
            align-items: center;
        }
        .top-nav a {
            display: inline-block;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .top-nav a.active {
            background: #007bff;
            color: white;
        }
        .top-nav a:not(.active) {
            background: #f8f9fa;
            color: #333;
        }
        .top-nav a:not(.active):hover {
            background: #e9ecef;
        }
        .top-nav .logo {
            font-size: 18px;
            font-weight: bold;
            color: #007bff;
            margin-right: 20px;
            padding-right: 20px;
            border-right: 2px solid #e9ecef;
        }

        .nav { margin-bottom: 20px; }
        .nav a { display: inline-block; padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-right: 10px; }
        .nav a:hover { background: #0056b3; }
        .stats { display: flex; gap: 20px; margin-bottom: 30px; }
        .stat-card { flex: 1; padding: 20px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #007bff; }
        .stat-card h3 { color: #666; font-size: 14px; margin-bottom: 10px; }
        .stat-card .value { font-size: 32px; font-weight: bold; color: #333; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; vertical-align: middle; }
        th { background: #f8f9fa; font-weight: 600; color: #333; }
        tr:hover { background: #f8f9fa; }
        .status { padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; }
        .status.active { background: #d4edda; color: #155724; }
        .status.inactive { background: #f8d7da; color: #721c24; }
        .actions a { display: inline-block; padding: 6px 12px; margin-right: 5px; text-decoration: none; border-radius: 4px; font-size: 13px; }
        .btn-primary { background: #007bff; color: white; }
        .btn-success { background: #28a745; color: white; }
        .btn-warning { background: #ffc107; color: #333; }
        .btn-danger { background: #dc3545; color: white; }
        .btn-info { background: #17a2b8; color: white; }
        .btn-test { background: #6c757d; color: white; }
        .actions a:hover { opacity: 0.8; }
        .latency, .traffic-pill { font-weight: 600; }
        .latency.good { color: #28a745; }
        .latency.medium { color: #ffc107; }
        .latency.bad { color: #dc3545; }
        .latency.testing { color: #6c757d; }
        .latency-status-wrap { display: flex; align-items: center; gap: 6px; }
        .latency-dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; background: #dfe3e6; border: 1px solid #c2c7cf; }
        .latency-dot.healthy { background: #28a745; border-color: #218838; }
        .latency-dot.warning { background: #ffc107; border-color: #e0a800; }
        .latency-dot.critical { background: #dc3545; border-color: #c82333; }
        .traffic-cell { display: flex; align-items: center; gap: 8px; }
        .traffic-pill { padding: 4px 12px; border-radius: 999px; font-size: 12px; background: #f1f3f5; color: #495057; cursor: pointer; transition: background 0.2s, color 0.2s; min-width: 75px; text-align: center; }
        .traffic-pill.healthy { background: #d4edda; color: #155724; }
        .traffic-pill.warning { background: #fff3cd; color: #856404; }
        .traffic-pill.critical { background: #f8d7da; color: #721c24; }
        .traffic-pill:focus-visible { outline: 2px solid #0d6efd; outline-offset: 2px; }
        .quality-card { margin-bottom: 20px; padding: 20px; background: #eef2ff; border-radius: 10px; border: 1px solid #dbe1ff; }
        .quality-card h2 { margin-bottom: 10px; font-size: 20px; color: #3949ab; }
        .quality-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
        .quality-card label { font-size: 13px; color: #555; margin-bottom: 5px; display: block; }
        .quality-card input, .quality-card select { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #c5cae9; font-size: 14px; }
        .quality-switch { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .quality-actions { margin-top: 15px; display: flex; gap: 10px; align-items: center; }
        .quality-status { font-weight: 600; }
        .quality-status.enabled { color: #28a745; }
        .quality-status.disabled { color: #dc3545; }
        .quality-modal { position: fixed; inset: 0; background: rgba(6,11,40,0.55); display: none; justify-content: center; align-items: flex-start; padding: 40px 20px; z-index: 2000; overflow-y: auto; }
        .quality-modal.show { display: flex; }
        .quality-modal-card { width: min(1040px, 95%); background: #fff; border-radius: 18px; padding: 28px 32px; box-shadow: 0 25px 90px rgba(15,23,42,0.35); animation: modal-pop 0.25s ease forwards; }
        .modal-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
        .modal-header h2 { margin: 0; font-size: 24px; color: #111827; }
        .modal-subtitle { margin: 4px 0 0 0; color: #6c757d; font-size: 13px; }
        .modal-header-actions { display: flex; align-items: center; gap: 12px; }
        .loading-indicator { font-size: 13px; color: #0d6efd; display: none; }
        .quality-modal-close { width: 40px; height: 40px; border-radius: 999px; border: none; background: #f1f3f5; color: #1f2937; font-size: 22px; cursor: pointer; line-height: 1; transition: background 0.2s, transform 0.2s; }
        .quality-modal-close:hover { background: #e2e6ea; transform: translateY(-1px); }
        .quality-metrics-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .metric-card { background: linear-gradient(135deg, #f8faff 0%, #eef2ff 100%); border-radius: 14px; padding: 16px 18px; border: 1px solid #dbe4ff; box-shadow: 0 10px 30px rgba(37,99,235,0.06); }
        .metric-label { font-size: 13px; color: #6b7280; letter-spacing: 0.4px; text-transform: none; }
        .metric-value { font-size: 28px; font-weight: 600; color: #111827; margin-top: 6px; }
        .time-range-selector { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
        .range-btn { padding: 8px 18px; border-radius: 999px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; color: #4b5563; font-size: 13px; transition: all 0.2s ease; }
        .range-btn:hover { border-color: #0d6efd; color: #0d6efd; }
        .range-btn.active { background: #0d6efd; color: #fff; border-color: #0d6efd; box-shadow: 0 8px 20px rgba(13,110,253,0.25); }
        .range-btn:disabled { cursor: not-allowed; opacity: 0.6; }
        #quality-chart { border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; margin-bottom: 26px; padding: 12px; }
        .data-table-section { margin-top: 12px; }
        .data-table-section h3 { margin: 0 0 10px 0; font-size: 16px; color: #1f2937; display: flex; align-items: center; gap: 10px; }
        .table-hint { font-size: 12px; color: #6b7280; font-weight: normal; }
        .data-table-wrapper { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; background: #fff; }
        #quality-data-table { width: 100%; border-collapse: collapse; }
        #quality-data-table th, #quality-data-table td { padding: 12px 14px; text-align: left; }
        #quality-data-table thead th { background: #f8fafc; font-size: 13px; color: #475569; text-transform: none; }
        #quality-data-table tbody td { border-top: 1px solid #eef2f7; font-size: 13px; color: #1f2937; }
        #quality-data-table tbody tr { transition: background 0.2s ease; cursor: pointer; }
        #quality-data-table tbody tr:hover { background: #eef5ff; }
        .sortable { cursor: pointer; user-select: none; }
        .sortable .sort-indicator { font-size: 11px; color: #94a3b8; margin-left: 4px; }
        .sortable.active { color: #0d6efd; }
        .sortable.active .sort-indicator { color: #0d6efd; }
        .status-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: capitalize; }
        .status-badge.healthy { background: #d1fae5; color: #065f46; }
        .status-badge.warning { background: #fef3c7; color: #92400e; }
        .status-badge.critical { background: #fee2e2; color: #b91c1c; }
        .status-badge.unknown { background: #e2e8f0; color: #475569; }
        .status-badge.testing { background: #f3e8ff; color: #6d28d9; }
        .table-row-active { background: #e0edff !important; }
        .data-empty { text-align: center; padding: 24px 12px; color: #6b7280; font-size: 13px; }
        .quality-modal-error { margin-top: 16px; color: #dc3545; font-size: 13px; }
        @keyframes modal-pop {
            from { opacity: 0; transform: translateY(20px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
</head>
<body>
    <div class="container">
        <!-- 统一顶部导航栏 -->
        <div class="top-nav">
            <div class="logo">🚀 goForward</div>
            <a href="/">📡 端口隧道</a>
            <a href="/proxy" class="active">🔐 代理转发</a>
            <a href="/environment">⚙️ 环境配置</a>
        </div>

        <h1>🔐 代理转发</h1>
        <p style="color: #666; margin-bottom: 20px;">VLESS+Reality 入站 → Hysteria2/VMess/SOCKS5 出站</p>

        <div class="nav">
            <a href="/proxy/add">➕ 添加代理</a>
            <a href="javascript:void(0)" onclick="showHy2Install()" style="background: #28a745;">🚀 快速安装Hysteria2</a>
            <a href="javascript:void(0)" onclick="exportSelected()" style="background: #17a2b8;">📤 导出配置</a>
            <a href="javascript:void(0)" onclick="showImportModal()" style="background: #6f42c1;">📥 导入配置</a>
            <a href="javascript:void(0)" onclick="batchRestart()" style="background: #fd7e14;">🔄 批量重启全部代理</a>
            <a href="javascript:void(0)" onclick="batchInit()" style="background: #dc3545;">🛠️ 一键重建运行环境</a>
        </div>

        <div class="quality-card">
            <div class="quality-switch">
                <label style="margin: 0;">
                    <input type="checkbox" id="quality-enabled" {{if .qualityConfig.Enabled}}checked{{end}}>
                    启用线路质量监控
                </label>
                <span class="quality-status {{if .qualityRunning}}enabled{{else}}disabled{{end}}">
                    {{if .qualityRunning}}运行中{{else}}未运行{{end}}
                </span>
            </div>
            <form id="quality-config-form">
                <div class="quality-grid">
                    <div>
                        <label>监控线路ID（逗号/区间）</label>
                        <input type="text" name="proxy_ids" id="quality-proxies" value="{{.qualityProxySpec}}" placeholder="4,7,9-11">
                    </div>
                    <div>
                        <label>检测目标地址</label>
                        <input type="text" name="target" id="quality-target" value="{{.qualityConfig.TestTarget}}" placeholder="rtmp.tiktok.com:1935">
                    </div>
                    <div>
                        <label>间隔（秒）</label>
                        <input type="number" name="interval_seconds" id="quality-interval" value="{{.qualityIntervalSeconds}}" min="15">
                    </div>
                    <div>
                        <label>每次探测次数</label>
                        <input type="number" name="probe_count" id="quality-probe" value="{{.qualityConfig.ProbeCount}}" min="1">
                    </div>
                    <div>
                        <label>并发数量</label>
                        <input type="number" name="max_concurrent" id="quality-concurrent" value="{{.qualityConfig.MaxConcurrent}}" min="1">
                    </div>
                    <div>
                        <label>延迟警戒 (ms)</label>
                        <input type="number" name="warn_latency" id="quality-latency" value="{{.qualityConfig.WarnLatencyMs}}" min="10">
                    </div>
                    <div>
                        <label>丢包警戒 (%)</label>
                        <input type="number" name="warn_loss" id="quality-loss" value="{{printf "%.1f" .qualityConfig.WarnLossPercent}}" step="0.1" min="0">
                    </div>
                    <div>
                        <label>连续失败阈值</label>
                        <input type="number" name="warn_failures" id="quality-failures" value="{{.qualityConfig.WarnConsecutiveFailure}}" min="1">
                    </div>
                    <div>
                        <label>保留天数</label>
                        <input type="number" name="retention_days" id="quality-retention" value="{{.qualityConfig.RetentionDays}}" min="0">
                    </div>
                </div>
                <div class="quality-actions">
                    <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">💾 保存监控配置</button>
                    <span id="quality-save-tip" style="font-size: 13px; color: #555;"></span>
                </div>
            </form>
        </div>

        <div class="stats">
            <div class="stat-card">
                <h3>总代理数</h3>
                <div class="value">{{.stats.total}}</div>
            </div>
            <div class="stat-card">
                <h3>运行中</h3>
                <div class="value">{{.stats.active}}</div>
            </div>
            <div class="stat-card">
                <h3>总流量</h3>
                <div class="value">{{.stats.total_traffic}}</div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAll" onchange="toggleAll()"></th>
                    <th>ID</th>
                    <th>名称</th>
                    <th>入站端口</th>
                    <th>出站类型</th>
                    <th>Reality域名</th>
                    <th>出站服务器</th>
                    <th>状态</th>
                    <th>RTT</th>
                    <th>今日流量</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{range .proxyList}}
                <tr data-proxy-id="{{.Id}}" data-proxy-name="{{.Name}}" data-total-traffic="{{.TotalTraffic}}" data-today-traffic="{{if .TodayTraffic}}{{.TodayTraffic}}{{else}}{{.TotalTraffic}}{{end}}">
                    <td><input type="checkbox" name="proxyIds" value="{{.Id}}" onchange="updateSelectAll()"></td>
                    <td>{{.Id}}</td>
                    <td><strong>{{.Name}}</strong><br><small style="color: #666;">{{.Remark}}</small></td>
                    <td>{{.InboundPort}}</td>
                    <td>
                        {{if eq .OutboundType "socks5"}}
                        <span style="background: #17a2b8; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">SOCKS5</span>
                        {{else if eq .OutboundType "vmess"}}
                        <span style="background: #6f42c1; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">VMess</span>
                        {{else}}
                        <span style="background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">Hysteria2</span>
                        {{end}}
                    </td>
                    <td>{{.RealityServerName}}</td>
                    <td>
                        {{if eq .OutboundType "socks5"}}
                        {{.Socks5Addr}}:{{.Socks5Port}}
                        {{else if eq .OutboundType "vmess"}}
                        {{.VmessServer}}:{{.VmessPort}}
                        {{else}}
                        {{.Hy2Server}}:{{.Hy2Port}}
                        {{end}}
                    </td>
                    <td>
                        {{if eq .Status 0}}
                        <span class="status active">运行中</span>
                        {{else}}
                        <span class="status inactive">已停止</span>
                        {{end}}
                    </td>
                    <td>
                        <div class="latency-status-wrap">
                            <span id="latency-{{.Id}}" class="latency">-</span>
                            <span id="latency-status-{{.Id}}" class="latency-dot" title=""></span>
                        </div>
                    </td>
                    <td>
                        <div class="traffic-cell">
                            <div
                                id="traffic-{{.Id}}"
                                class="traffic-pill"
                                onclick="openQualityModal({{.Id}})"
                                onkeydown="handleTrafficPillKey(event, {{.Id}})"
                                role="button"
                                tabindex="0"
                                title="点击查看线路质量"
                            >{{if .TodayTraffic}}{{.TodayTraffic}}{{else}}{{.TotalTraffic}}{{end}}</div>
                        </div>
                    </td>
                    <td class="actions">
                        <a href="javascript:void(0)" onclick="testOutbound({{.Id}})" class="btn-test" id="test-btn-{{.Id}}">测试</a>
                        <a href="/proxy/edit/{{.Id}}" class="btn-primary">编辑</a>
                        <a href="javascript:void(0)" onclick="showSubscriptionModal({{.Id}}, '{{.Name}}')" class="btn-info">订阅</a>
                        <a href="javascript:void(0)" onclick="restartProxy({{.Id}}, '{{.Name}}')" class="btn-info" id="restart-btn-{{.Id}}" style="background:#fd7e14;">重启</a>
                        {{if eq .Status 0}}
                        <a href="javascript:void(0)" onclick="toggleProxy({{.Id}}, '{{.Name}}', 'stop')" class="btn-warning" id="toggle-btn-{{.Id}}">停止</a>
                        {{else}}
                        <a href="javascript:void(0)" onclick="toggleProxy({{.Id}}, '{{.Name}}', 'start')" class="btn-success" id="toggle-btn-{{.Id}}">启动</a>
                        {{end}}
                        <a href="javascript:void(0)" onclick="deleteProxy({{.Id}}, '{{.Name}}')" class="btn-danger" id="delete-btn-{{.Id}}">删除</a>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="11" style="text-align: center; padding: 40px; color: #999;">
                        暂无代理配置，<a href="/proxy/add" style="color: #007bff;">点击添加</a>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div id="quality-modal" class="quality-modal" aria-hidden="true">
        <div class="quality-modal-card" role="dialog" aria-modal="true" aria-labelledby="quality-modal-title">
            <div class="modal-header">
                <div>
                    <h2 id="quality-modal-title">线路质量</h2>
                    <p id="quality-modal-subtitle" class="modal-subtitle">线路ID -</p>
                </div>
                <div class="modal-header-actions">
                    <span id="quality-modal-loading" class="loading-indicator">加载中...</span>
                    <button type="button" class="quality-modal-close" aria-label="关闭">×</button>
                </div>
            </div>

            <div class="quality-metrics-cards">
                <div class="metric-card">
                    <div class="metric-label">最新延迟</div>
                    <div class="metric-value" id="metric-latency">-</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">抖动</div>
                    <div class="metric-value" id="metric-jitter">-</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">丢包率</div>
                    <div class="metric-value" id="metric-loss">-</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">今日流量</div>
                    <div class="metric-value" id="metric-traffic">-</div>
                </div>
            </div>

            <div class="time-range-selector">
                <button class="range-btn active" data-range="30d">最近30天</button>
                <button class="range-btn" data-range="7d">最近7天</button>
                <button class="range-btn" data-range="24h">最近24小时</button>
            </div>

            <div id="quality-chart" style="width: 100%; height: 400px;"></div>

            <div class="data-table-section">
                <h3>详细数据 <span class="table-hint">点击行查看详情</span></h3>
                <div class="data-table-wrapper">
                    <table id="quality-data-table">
                        <thead>
                            <tr>
                                <th>时间</th>
                                <th class="sortable" data-sort="traffic">流量 <span class="sort-indicator">↑↓</span></th>
                                <th class="sortable" data-sort="latency">延迟 <span class="sort-indicator">↑↓</span></th>
                                <th class="sortable" data-sort="jitter">抖动 <span class="sort-indicator">↑↓</span></th>
                                <th class="sortable" data-sort="loss">丢包率 <span class="sort-indicator">↑↓</span></th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody id="quality-table-body">
                            <tr><td colspan="6" class="data-empty">请选择线路以查看数据</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="quality-modal-error" class="quality-modal-error" style="display:none;"></div>
        </div>
    </div>

    <!-- 订阅弹窗 -->
    <div id="subscription-modal" class="quality-modal" aria-hidden="true">
        <div class="quality-modal-card" role="dialog" aria-modal="true" style="max-width: 700px;">
            <div class="modal-header">
                <div>
                    <h2 id="sub-modal-title">📱 订阅链接</h2>
                    <p id="sub-modal-subtitle" class="modal-subtitle">节点名称</p>
                </div>
                <button type="button" class="quality-modal-close" onclick="closeSubscriptionModal()" aria-label="关闭">×</button>
            </div>

            <div id="sub-modal-content">
                <div style="text-align: center; padding: 40px; color: #666;">
                    <div style="font-size: 24px; margin-bottom: 10px;">⏳</div>
                    加载中...
                </div>
            </div>
        </div>
    </div>

    <!-- 远程安装Hysteria2弹窗 -->
    <div id="remote-install-modal" class="quality-modal" aria-hidden="true">
        <div class="quality-modal-card" role="dialog" aria-modal="true" style="max-width: 600px;">
            <div class="modal-header">
                <div>
                    <h2>🚀 远程安装 Hysteria2</h2>
                    <p class="modal-subtitle">输入服务器信息，自动安装并生成节点</p>
                </div>
                <button type="button" class="quality-modal-close" onclick="closeRemoteInstallModal()" aria-label="关闭">×</button>
            </div>

            <form id="remote-install-form" onsubmit="return submitRemoteInstall(event)">
                <div style="display: grid; gap: 15px; margin-bottom: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">服务器IP地址 <span style="color: #dc3545;">*</span></label>
                        <input type="text" id="remote-host" name="host" required placeholder="例如: 192.168.1.100" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div>
                            <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">SSH端口</label>
                            <input type="number" id="remote-port" name="port" value="22" placeholder="22" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">Hysteria2端口</label>
                            <input type="number" id="remote-hy2-port" name="hy2Port" value="443" placeholder="443" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">用户名 <span style="color: #dc3545;">*</span></label>
                        <input type="text" id="remote-user" name="user" value="root" required placeholder="root" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">密码 <span style="color: #dc3545;">*</span></label>
                        <input type="password" id="remote-password" name="password" required placeholder="SSH登录密码" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 5px; font-weight: 600; color: #333;">节点名称</label>
                        <input type="text" id="remote-node-name" name="nodeName" placeholder="留空则自动生成" style="width: 100%; padding: 10px 12px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px;">
                    </div>
                </div>

                <div style="background: #fff3cd; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #ffc107;">
                    <p style="margin: 0; font-size: 13px; color: #856404;">
                        <strong>⚠️ 注意事项：</strong><br>
                        • 将在目标服务器上安装 Hysteria2<br>
                        • 自动生成自签名证书和配置<br>
                        • 安装完成后自动添加到本地节点列表<br>
                        • 请确保目标服务器可以访问外网
                    </p>
                </div>

                <div id="remote-install-progress" style="display: none; margin-bottom: 20px;">
                    <div style="background: #e3f2fd; padding: 15px; border-radius: 8px; border-left: 4px solid #2196f3;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div class="spinner" style="width: 20px; height: 20px; border: 2px solid #2196f3; border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                            <span id="remote-install-status" style="color: #1565c0; font-weight: 500;">正在连接服务器...</span>
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeRemoteInstallModal()" style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px;">取消</button>
                    <button type="submit" id="remote-install-submit" style="padding: 10px 20px; background: #28a745; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 600;">🚀 开始安装</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .copy-btn {
            padding: 8px 16px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
        }
        .copy-btn:hover {
            background: #0056b3;
        }
        .copy-btn.copied {
            background: #28a745;
        }
        .sub-link-box {
            background: #f8f9fa;
            padding: 12px 15px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            word-break: break-all;
            font-family: 'Monaco', 'Menlo', monospace;
            font-size: 12px;
            color: #495057;
            max-height: 80px;
            overflow-y: auto;
        }
        .sub-section {
            margin-bottom: 20px;
            padding: 15px;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
        }
        .sub-section h3 {
            margin: 0 0 10px 0;
            font-size: 15px;
            color: #333;
        }
        .sub-section p {
            margin: 0 0 10px 0;
            font-size: 13px;
            color: #666;
        }
        .qrcode-container {
            text-align: center;
            padding: 15px;
            background: white;
            border-radius: 8px;
        }
        .qrcode-container canvas {
            border: 1px solid #eee;
            border-radius: 4px;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <script>
        const proxyQualityCache = {};
        const proxyTrafficTrendCache = {};
        let currentQualityModalId = null;
        document.addEventListener('DOMContentLoaded', () => {
            const qualityForm = document.getElementById('quality-config-form');
            if (qualityForm) {
                qualityForm.addEventListener('submit', saveQualityConfig);
            }
            loadProxyMetrics();
            initQualityModalEvents();
        });

        async function saveQualityConfig(event) {
            event.preventDefault();
            const tip = document.getElementById('quality-save-tip');
            tip.textContent = '保存中...';

            const formData = new FormData(event.target);
            formData.append('enabled', document.getElementById('quality-enabled').checked ? '1' : '0');

            try {
                const response = await fetch('/proxy/quality-config', {
                    method: 'POST',
                    body: formData,
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || '保存失败');
                }
                tip.style.color = '#28a745';
                tip.textContent = '✅ 配置已更新';
                const statusEl = document.querySelector('.quality-status');
                if (statusEl) {
                    statusEl.textContent = data.running ? '运行中' : '未运行';
                    statusEl.className = 'quality-status ' + (data.running ? 'enabled' : 'disabled');
                }
            } catch (error) {
                tip.style.color = '#dc3545';
                tip.textContent = '❌ ' + error.message;
            } finally {
                setTimeout(() => {
                    tip.textContent = '';
                    tip.style.color = '#555';
                }, 3000);
            }
        }

        async function loadProxyMetrics() {
            const rows = document.querySelectorAll('tbody tr[data-proxy-id]');
            if (!rows.length) return;
            const batchSize = 10;
            const ids = Array.from(rows).map(row => row.getAttribute('data-proxy-id'));
            for (let i = 0; i < ids.length; i += batchSize) {
                const chunk = ids.slice(i, i + batchSize);
                await Promise.all(chunk.map(async (id) => {
                    if (!id) return;
                    try {
                        const response = await fetch(`/proxy/quality/${id}?limit=5&resolution=minute`);
                        const data = await response.json();
                        if (!response.ok) {
                            throw new Error(data.error || '加载失败');
                        }
                        proxyQualityCache[id] = data;
                        const samples = (data.samples || {});
                        const qualitySamples = samples.quality || [];
                        const latestQualitySample = qualitySamples.length ? qualitySamples[qualitySamples.length - 1] : null;
                        const latestStatus = (latestQualitySample && latestQualitySample.Status) || (data.latest && data.latest.Status) || null;
                        updateLatencyBadge(id, latestQualitySample, data.latest || null);
                        const fallbackTraffic = (data.proxy && (data.proxy.TodayTraffic || data.proxy.TotalTraffic)) || getRowTodayTraffic(id);
                        updateTrafficBadge(id, samples.traffic || [], fallbackTraffic, latestStatus);
                    } catch (error) {
                        console.warn('加载线路状态失败', id, error);
                        updateLatencyBadge(id, null, null);
                        updateTrafficBadge(id, [], getRowTodayTraffic(id), null);
                    }
                }));
            }
        }

        function updateLatencyBadge(id, sample, fallbackLog) {
            const latencyEl = document.getElementById(`latency-${id}`);
            const statusEl = document.getElementById(`latency-status-${id}`);
            if (!latencyEl || !statusEl) return;
            let data = sample;
            if (!data && fallbackLog) {
                data = {
                    LatencyMs: fallbackLog.LatencyAvgMs,
                    Status: fallbackLog.Status,
                };
            }
            if (!data) {
                latencyEl.textContent = '-';
                latencyEl.className = 'latency';
                statusEl.className = 'latency-dot';
                statusEl.title = '';
                return;
            }
            const latency = typeof data.LatencyMs === 'number' ? data.LatencyMs : '-';
            latencyEl.textContent = latency === '-' ? '-' : `${latency}ms`;
            latencyEl.className = 'latency ' + classifyLatency(latency);
            const status = data.Status ? data.Status.toLowerCase() : '';
            statusEl.className = `latency-dot${status ? ' ' + status : ''}`;
            statusEl.title = data.Status || '';
        }

        function updateTrafficBadge(id, samples, fallbackTotal, status) {
            const pill = document.getElementById(`traffic-${id}`);
            if (!pill) return;
            let text = '0 B';
            if (fallbackTotal && fallbackTotal.trim() !== '') {
                text = fallbackTotal.trim();
            } else if (samples.length) {
                const latest = samples[samples.length - 1];
                const totalBytes = (latest.BytesUp || 0) + (latest.BytesDown || 0);
                text = formatBytesHuman(totalBytes);
            }
            pill.textContent = text;
            const statusClass = status ? status.toLowerCase() : '';
            pill.className = `traffic-pill${statusClass ? ' ' + statusClass : ''}`;
        }

        function getRowTodayTraffic(id) {
            const row = document.querySelector(`tr[data-proxy-id="${id}"]`);
            if (!row) return '';
            return row.getAttribute('data-today-traffic') || row.getAttribute('data-total-traffic') || '';
        }

        function classifyLatency(latency) {
            if (typeof latency !== 'number') return '';
            if (latency < 100) return 'good';
            if (latency < 300) return 'medium';
            return 'bad';
        }

        function handleTrafficPillKey(event, id) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                openQualityModal(id);
            }
        }

        function openQualityModal(id) {
            currentQualityModalId = id;
            const modal = document.getElementById('quality-modal');
            if (!modal) return;
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
            const row = document.querySelector(`tr[data-proxy-id="${id}"]`);
            const fallbackName = row ? row.dataset.proxyName || `线路 #${id}` : `线路 #${id}`;
            document.getElementById('quality-modal-title').textContent = fallbackName;
            document.getElementById('quality-modal-subtitle').textContent = `线路ID ${id}`;
            setQualityModalError('');
            setQualityModalLoading(true);

            // 初始化ECharts图表
            initECharts();

            if (proxyQualityCache[id]) {
                populateQualityModal(proxyQualityCache[id], fallbackName);
            } else {
                resetQualityModalMetrics();
            }
            fetchQualityDetail(id, fallbackName);
            updateQualityChart(id);
        }

        async function fetchQualityDetail(id, fallbackName) {
            try {
                const response = await fetch(`/proxy/quality/${id}?limit=60&resolution=minute`);
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || '加载失败');
                }
                proxyQualityCache[id] = data;
                populateQualityModal(data, fallbackName);
                setQualityModalLoading(false);
            } catch (error) {
                setQualityModalLoading(false);
                setQualityModalError(error.message || '加载失败');
            }
        }

        function closeQualityModal() {
            const modal = document.getElementById('quality-modal');
            if (!modal) return;
            modal.classList.remove('show');
            document.body.style.overflow = '';
            setQualityModalError('');
            setQualityModalLoading(false);

            // 销毁图表实例
            if (qualityChart) {
                qualityChart.dispose();
                qualityChart = null;
            }
        }

        function initQualityModalEvents() {
            const modal = document.getElementById('quality-modal');
            if (!modal) return;

            // 关闭按钮点击事件
            const closeBtn = modal.querySelector('.quality-modal-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', closeQualityModal);
            }

            // 点击背景关闭
            modal.addEventListener('click', (event) => {
                if (event.target === modal) {
                    closeQualityModal();
                }
            });

            // ESC键关闭
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal.classList.contains('show')) {
                    closeQualityModal();
                }
            });
        }

        function resetQualityModalMetrics() {
            const ids = ['latency', 'jitter', 'loss', 'traffic'];
            ids.forEach(id => {
                const el = document.getElementById(`metric-${id}`);
                if (el) el.textContent = '-';
            });
            const samples = document.getElementById('quality-modal-samples');
            const logs = document.getElementById('quality-modal-logs');
            if (samples) samples.innerHTML = '<div class="quality-modal-empty">暂无采样数据</div>';
            if (logs) logs.innerHTML = '<div class="quality-modal-empty">暂无巡检日志</div>';
            resetTrafficTrendChart();
        }

        function setQualityModalLoading(isLoading) {
            const hint = document.getElementById('quality-modal-loading');
            if (!hint) return;
            hint.style.display = isLoading ? 'inline-block' : 'none';
        }

        function setQualityModalError(message) {
            const el = document.getElementById('quality-modal-error');
            if (!el) return;
            if (message) {
                el.style.display = 'block';
                el.textContent = `⚠️ ${message}`;
            } else {
                el.style.display = 'none';
                el.textContent = '';
            }
        }

        function populateQualityModal(data, fallbackName) {
            if (!data) return;
            const proxy = data.proxy || {};
            const name = proxy.Name || fallbackName || `线路 #${proxy.Id || ''}`;
            document.getElementById('quality-modal-title').textContent = name;
            document.getElementById('quality-modal-subtitle').textContent = `线路ID ${proxy.Id || currentQualityModalId || ''}`;

            const qualitySamples = (data.samples && data.samples.quality) || [];
            const trafficSamples = (data.samples && data.samples.traffic) || [];
            const latestQuality = qualitySamples.length ? qualitySamples[qualitySamples.length - 1] : (data.latest || null);
            const latestTraffic = trafficSamples.length ? trafficSamples[trafficSamples.length - 1] : null;

            const latencyEl = document.getElementById('metric-latency');
            const jitterEl = document.getElementById('metric-jitter');
            const lossEl = document.getElementById('metric-loss');
            const trafficEl = document.getElementById('metric-traffic');

            if (latencyEl) latencyEl.textContent = latestQuality && typeof latestQuality.LatencyMs === 'number' ? `${latestQuality.LatencyMs} ms` : '暂无';
            if (jitterEl) jitterEl.textContent = latestQuality && typeof latestQuality.JitterMs === 'number' ? `${latestQuality.JitterMs} ms` : '暂无';
            if (lossEl) lossEl.textContent = latestQuality && typeof latestQuality.LossPct === 'number' ? `${latestQuality.LossPct.toFixed(1)} %` : '暂无';
            if (trafficEl) {
                if (proxy.TodayTraffic) {
                    trafficEl.textContent = proxy.TodayTraffic;
                } else if (proxy.TotalTraffic) {
                    trafficEl.textContent = proxy.TotalTraffic;
                } else {
                    trafficEl.textContent = '暂无';
                }
            }

            renderQualityModalSamples(qualitySamples, trafficSamples);
            renderQualityModalLogs(data.logs || []);
            setQualityModalError('');
        }

        function renderQualityModalSamples(qualitySamples, trafficSamples) {
            const tbody = document.getElementById('quality-table-body');
            if (!tbody) return;
            const rows = mergeSampleRows(qualitySamples, trafficSamples);
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="data-empty">暂无数据</td></tr>';
                return;
            }
            const body = rows.map(row => {
                const latency = row.quality && typeof row.quality.LatencyMs === 'number' ? `${row.quality.LatencyMs}` : null;
                const jitter = row.quality && typeof row.quality.JitterMs === 'number' ? `${row.quality.JitterMs}` : null;
                const loss = row.quality && typeof row.quality.LossPct === 'number' ? `${row.quality.LossPct.toFixed(1)}` : null;
                let trafficText = '-';
                if (row.traffic) {
                    const up = formatBytesHuman(row.traffic.BytesUp);
                    const down = formatBytesHuman(row.traffic.BytesDown);
                    trafficText = `${up} ↑ / ${down} ↓`;
                }
                const safeTraffic = escapeHtml(trafficText);
                const minuteText = escapeHtml(formatModalTime(row.minute));
                const status = (row.quality && row.quality.Status) || '-';
                const statusClass = status.toLowerCase();
                return `
                    <tr data-minute="${escapeHtml(row.minute)}" data-latency="${latency !== null ? latency : ''}" data-jitter="${jitter !== null ? jitter : ''}" data-loss="${loss !== null ? loss : ''}" data-traffic="${escapeHtml(trafficText)}" data-status="${escapeHtml(status)}" onclick="handleTableRowClick(this)">
                        <td>${minuteText}</td>
                        <td>${safeTraffic}</td>
                        <td>${latency !== null ? latency + ' ms' : '-'}</td>
                        <td>${jitter !== null ? jitter + ' ms' : '-'}</td>
                        <td>${loss !== null ? loss + ' %' : '-'}</td>
                        <td><span class="status-badge ${statusClass}">${escapeHtml(status)}</span></td>
                    </tr>
                `;
            }).join('');
            tbody.innerHTML = body;
        }

        function handleTableRowClick(row) {
            // 移除之前选中行的样式
            document.querySelectorAll('#quality-table-body tr').forEach(r => {
                r.classList.remove('table-row-active');
            });

            // 添加当前选中行的样式
            row.classList.add('table-row-active');

            // 获取数据
            const minute = row.dataset.minute;
            const latency = row.dataset.latency;
            const jitter = row.dataset.jitter;
            const loss = row.dataset.loss;
            const traffic = row.dataset.traffic;
            const status = row.dataset.status;

            // 可以在这里添加显示详细信息的逻辑
            console.log('选中数据:', {
                time: minute,
                latency: latency,
                jitter: jitter,
                loss: loss,
                traffic: traffic,
                status: status
            });
        }

        function mergeSampleRows(qualitySamples, trafficSamples) {
            const map = new Map();
            (qualitySamples || []).forEach(sample => {
                const key = normalizeMinuteKey(sample.Minute);
                map.set(key, { minute: key, quality: sample });
            });
            (trafficSamples || []).forEach(sample => {
                const key = normalizeMinuteKey(sample.Minute);
                const row = map.get(key) || { minute: key };
                row.traffic = sample;
                map.set(key, row);
            });
            const rows = Array.from(map.values()).sort((a, b) => {
                const tA = Date.parse(a.minute) || 0;
                const tB = Date.parse(b.minute) || 0;
                return tB - tA; // 倒序排列，最新的在前
            });
            const limit = 12;
            // 倒序后取前12条（最新的12条）
            return rows.slice(0, limit);
        }

        function renderQualityModalLogs(logs) {
            const container = document.getElementById('quality-modal-logs');
            if (!container) return;
            if (!logs.length) {
                container.innerHTML = '<div class="quality-modal-empty">暂无巡检日志</div>';
                return;
            }
            const head = `
                <table>
                    <thead>
                        <tr>
                            <th>时间</th>
                            <th>状态</th>
                            <th>延迟</th>
                            <th>丢包</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            const rows = logs.slice(0, 12).map(log => `
                <tr>
                    <td>${escapeHtml(formatModalTime(log.CreatedAt))}</td>
                    <td>${escapeHtml(log.Status || '-')}</td>
                    <td>${typeof log.LatencyAvgMs === 'number' ? log.LatencyAvgMs + ' ms' : '-'}</td>
                    <td>${typeof log.LossPercent === 'number' ? log.LossPercent.toFixed(1) + ' %' : '-'}</td>
                    <td>${escapeHtml(log.Message || '-')}</td>
                </tr>
            `).join('');
            container.innerHTML = head + rows + '</tbody></table>';
        }

        let qualityChart = null;
        let currentTimeRange = '30d';

        function initECharts() {
            const chartDom = document.getElementById('quality-chart');
            if (!chartDom) return null;

            // 如果图表已存在，则销毁
            if (qualityChart) {
                qualityChart.dispose();
            }

            qualityChart = echarts.init(chartDom);

            // 时间范围选择器事件
            document.querySelectorAll('.range-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentTimeRange = this.dataset.range;
                    if (currentQualityModalId) {
                        updateQualityChart(currentQualityModalId);
                    }
                });
            });

            return qualityChart;
        }

        function updateQualityChart(proxyId) {
            if (!qualityChart) {
                qualityChart = initECharts();
            }

            if (!qualityChart) return;

            let resolution = 'daily';
            let limit = 30;

            if (currentTimeRange === '24h') {
                resolution = 'hourly';
                limit = 24;
            } else if (currentTimeRange === '7d') {
                resolution = 'daily';
                limit = 7;
            } else {
                resolution = 'daily';
                limit = 30;
            }

            fetch(`/proxy/quality/${proxyId}?resolution=${resolution}&limit=${limit}`)
                .then(response => response.json())
                .then(data => {
                    renderQualityChart(data.samples || {});
                })
                .catch(error => {
                    console.error('Failed to load chart data:', error);
                    renderQualityChart({});
                });
        }

        // 填充完整时间范围
        function fillCompleteTimeRange(dataMap, timeRange) {
            const result = new Map(dataMap);
            const now = new Date();
            const emptyEntry = { quality: null, traffic: null };

            if (timeRange === '24h') {
                // 填充最近24小时（按小时）
                for (let i = 0; i < 24; i++) {
                    const time = new Date(now);
                    time.setHours(now.getHours() - (23 - i));
                    time.setMinutes(0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            } else if (timeRange === '7d') {
                // 填充最近7天（按天）
                for (let i = 0; i < 7; i++) {
                    const time = new Date(now);
                    time.setDate(now.getDate() - (6 - i));
                    time.setHours(0, 0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            } else if (timeRange === '30d') {
                // 填充最近30天（按天）
                for (let i = 0; i < 30; i++) {
                    const time = new Date(now);
                    time.setDate(now.getDate() - (29 - i));
                    time.setHours(0, 0, 0, 0);
                    const timeStr = time.toISOString();
                    if (!result.has(timeStr)) {
                        result.set(timeStr, emptyEntry);
                    }
                }
            }

            return result;
        }

        // 将时间截断到指定粒度（小时或天）
        function truncateTime(timeStr, granularity) {
            const date = new Date(timeStr);
            if (isNaN(date.getTime())) return timeStr;

            if (granularity === 'hour') {
                date.setMinutes(0, 0, 0);
            } else if (granularity === 'day') {
                date.setHours(0, 0, 0, 0);
            }
            return date.toISOString();
        }

        // 聚合quality数据（按小时或天）
        function aggregateQualityData(qualityData, granularity) {
            const aggregated = new Map();

            qualityData.forEach(item => {
                const time = item.Minute || '';
                const truncatedTime = truncateTime(time, granularity);

                if (!aggregated.has(truncatedTime)) {
                    aggregated.set(truncatedTime, {
                        latencySum: 0,
                        latencyCount: 0,
                        lossSum: 0,
                        lossCount: 0
                    });
                }

                const agg = aggregated.get(truncatedTime);
                if (typeof item.LatencyMs === 'number') {
                    agg.latencySum += item.LatencyMs;
                    agg.latencyCount++;
                }
                if (typeof item.LossPct === 'number') {
                    agg.lossSum += item.LossPct;
                    agg.lossCount++;
                }
            });

            // 计算平均值
            const result = new Map();
            aggregated.forEach((agg, time) => {
                result.set(time, {
                    LatencyMs: agg.latencyCount > 0 ? agg.latencySum / agg.latencyCount : null,
                    LossPct: agg.lossCount > 0 ? agg.lossSum / agg.lossCount : null
                });
            });

            return result;
        }

        function renderQualityChart(samples) {
            if (!qualityChart) return;

            const qualityData = samples.quality || [];
            const trafficData = samples.traffic || [];

            console.log('Quality data:', qualityData);
            console.log('Traffic data:', trafficData);

            // 处理时间轴
            const timeLabels = [];
            const latencyData = [];
            const lossData = [];
            const upData = [];
            const downData = [];
            const totalData = [];

            // 根据时间范围确定聚合粒度
            let granularity = 'hour';
            if (currentTimeRange === '7d' || currentTimeRange === '30d') {
                granularity = 'day';
            }

            // 先聚合quality数据
            const aggregatedQuality = aggregateQualityData(qualityData, granularity);

            // 合并数据（以traffic数据的时间为基准）
            const mergedData = new Map();

            // 先添加traffic数据
            trafficData.forEach(item => {
                const time = item.Minute || '';
                const truncatedTime = truncateTime(time, granularity);
                mergedData.set(truncatedTime, {
                    quality: aggregatedQuality.get(truncatedTime) || null,
                    traffic: item
                });
            });

            // 添加没有traffic数据但有quality数据的时间点
            aggregatedQuality.forEach((quality, time) => {
                if (!mergedData.has(time)) {
                    mergedData.set(time, { quality: quality, traffic: null });
                }
            });

            // 填充完整时间范围
            const filledData = fillCompleteTimeRange(mergedData, currentTimeRange);

            // 排序并提取数据 - 按时间正序排列（从旧到新）
            const sortedEntries = Array.from(filledData.entries()).sort((a, b) => {
                const timeA = a[0] || '';
                const timeB = b[0] || '';
                return new Date(timeA) - new Date(timeB);
            });

            sortedEntries.forEach(([time, data]) => {
                const displayTime = formatChartTime(time);
                timeLabels.push(displayTime);

                // 延迟数据
                latencyData.push(data.quality && typeof data.quality.LatencyMs === 'number'
                    ? parseFloat(data.quality.LatencyMs.toFixed(0)) : null);

                // 丢包数据
                lossData.push(data.quality && typeof data.quality.LossPct === 'number'
                    ? parseFloat(data.quality.LossPct.toFixed(1)) : null);

                // 流量数据
                if (data.traffic) {
                    const up = parseFloat(((data.traffic.BytesUp || 0) / (1024 * 1024)).toFixed(2));
                    const down = parseFloat(((data.traffic.BytesDown || 0) / (1024 * 1024)).toFixed(2));
                    upData.push(up);
                    downData.push(down);
                    totalData.push(up + down);
                } else {
                    upData.push(0);
                    downData.push(0);
                    totalData.push(0);
                }
            });

            console.log('Processed data:', {
                timeLabels,
                latencyData,
                lossData,
                upData,
                downData
            });

            // 计算流量最大值用于缩放
            const maxTraffic = Math.max(...totalData, 1);
            const maxLatency = Math.max(...latencyData.filter(v => v !== null), 100);

            const option = {
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'cross',
                        crossStyle: {
                            color: '#999'
                        }
                    },
                    formatter: function(params) {
                        let result = `<strong>${params[0].axisValue}</strong><br/>`;
                        params.forEach(param => {
                            if (param.seriesName.includes('流量')) {
                                result += `${param.marker}${param.seriesName}: ${param.value} MB<br/>`;
                            } else if (param.seriesName.includes('丢包')) {
                                result += `${param.marker}${param.seriesName}: ${param.value}%<br/>`;
                            } else {
                                result += `${param.marker}${param.seriesName}: ${param.value}ms<br/>`;
                            }
                        });
                        return result;
                    }
                },
                legend: {
                    data: ['上行流量', '下行流量', '延迟', '丢包率'],
                    top: 10
                },
                xAxis: [
                    {
                        type: 'category',
                        data: timeLabels,
                        axisPointer: {
                            type: 'shadow'
                        }
                    }
                ],
                yAxis: [
                    {
                        type: 'value',
                        name: '流量 (MB)',
                        position: 'left',
                        axisLabel: {
                            formatter: '{value} MB'
                        },
                        min: 0,
                        max: maxTraffic * 1.2
                    },
                    {
                        type: 'value',
                        name: '延迟 (ms)',
                        position: 'right',
                        axisLabel: {
                            formatter: '{value} ms'
                        },
                        min: 0,
                        max: maxLatency * 1.2
                    }
                ],
                series: [
                    {
                        name: '上行流量',
                        type: 'bar',
                        yAxisIndex: 0,
                        data: upData,
                        itemStyle: {
                            color: '#5470c6'
                        }
                    },
                    {
                        name: '下行流量',
                        type: 'bar',
                        yAxisIndex: 0,
                        data: downData,
                        itemStyle: {
                            color: '#91cc75'
                        }
                    },
                    {
                        name: '延迟',
                        type: 'line',
                        yAxisIndex: 1,
                        data: latencyData,
                        smooth: true,
                        itemStyle: {
                            color: '#ee6666'
                        },
                        lineStyle: {
                            width: 2
                        }
                    },
                    {
                        name: '丢包率',
                        type: 'line',
                        yAxisIndex: 1,
                        data: lossData,
                        smooth: true,
                        itemStyle: {
                            color: '#fac858'
                        },
                        lineStyle: {
                            width: 2
                        }
                    }
                ],
                grid: {
                    left: '3%',
                    right: '4%',
                    bottom: '3%',
                    top: '15%',
                    containLabel: true
                }
            };

            qualityChart.setOption(option, true);
        }

        function normalizeMinuteKey(value) {
            if (!value) return '';
            return value.includes('T') ? value : value.replace(' ', 'T');
        }

        function formatModalTime(value) {
            if (!value) return '-';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            return parsed.toLocaleString();
        }

        function formatTrendLabel(value) {
            if (!value) return '--';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            const month = String(parsed.getMonth() + 1).padStart(2, '0');
            const day = String(parsed.getDate()).padStart(2, '0');
            return `${month}-${day}`;
        }

        function formatTrendTooltipDate(value) {
            if (!value) return '-';
            const normalized = normalizeMinuteKey(value);
            const parsed = new Date(normalized);
            if (isNaN(parsed.getTime())) {
                return value;
            }
            return parsed.toLocaleDateString();
        }

        function formatChartTime(value) {
            if (!value) return '';

            // 直接解析 ISO 8601 格式的字符串（包含时区）
            const parsed = new Date(value);
            if (isNaN(parsed.getTime())) {
                // 如果解析失败，尝试手动解析
                const timeStr = value.replace('T', ' ').replace('+08:00', '').replace('Z', '');
                const fallbackParsed = new Date(timeStr + ' +08:00');
                if (isNaN(fallbackParsed.getTime())) {
                    return value;
                }
                return formatDateByRange(fallbackParsed, currentTimeRange);
            }

            return formatDateByRange(parsed, currentTimeRange);
        }

        function formatDateByRange(dateObj, range) {
            if (range === '24h') {
                // 24小时视图：显示小时
                return dateObj.getHours().toString().padStart(2, '0') + ':00';
            } else if (range === '7d') {
                // 7天视图：显示月/日 小时
                const month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
                const day = dateObj.getDate().toString().padStart(2, '0');
                const hour = dateObj.getHours().toString().padStart(2, '0');
                return `${month}/${day} ${hour}:00`;
            } else {
                // 30天视图：只显示月/日
                const month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
                const day = dateObj.getDate().toString().padStart(2, '0');
                return `${month}/${day}`;
            }
        }

        function formatTrafficSummary(sample) {
            if (!sample) return '-';
            const total = (sample.BytesUp + sample.BytesDown) / (1024 * 1024);
            return `${total.toFixed(2)} MB`;
        }

        function formatBytesHuman(bytes) {
            if (!bytes || bytes <= 0) return '0 B';
            const units = ['B', 'KB', 'MB', 'GB', 'TB'];
            let idx = 0;
            let value = bytes;
            while (value >= 1024 && idx < units.length - 1) {
                value /= 1024;
                idx++;
            }
            return `${value.toFixed(2)} ${units[idx]}`;
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function testProxy(id) {
            const latencyEl = document.getElementById('latency-' + id);
            const testBtn = document.getElementById('test-btn-' + id);

            // 显示测试中状态
            latencyEl.textContent = '测试中...';
            latencyEl.className = 'latency testing';
            testBtn.textContent = '测试中';
            testBtn.style.opacity = '0.6';
            testBtn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/test/' + id);
                const result = await response.json();

                if (result.success) {
                    latencyEl.textContent = result.rtt;

                    // 根据延迟设置颜色
                    const ms = result.latency / 1000000; // 纳秒转毫秒
                    if (ms < 100) {
                        latencyEl.className = 'latency good';
                    } else if (ms < 300) {
                        latencyEl.className = 'latency medium';
                    } else {
                        latencyEl.className = 'latency bad';
                    }
                } else {
                    latencyEl.textContent = '失败';
                    latencyEl.className = 'latency bad';
                    alert('测试失败: ' + result.message);
                }
            } catch (error) {
                latencyEl.textContent = '错误';
                latencyEl.className = 'latency bad';
                alert('测试出错: ' + error.message);
            } finally {
                // 恢复按钮状态
                testBtn.textContent = '测试';
                testBtn.style.opacity = '1';
                testBtn.style.pointerEvents = 'auto';
            }
        }

