                selectAll.indeterminate = false;
                selectAll.checked = false;
            } else if (checkedIds.length === proxyIds.length) {
                selectAll.indeterminate = false;
                selectAll.checked = true;
            } else {
                selectAll.indeterminate = true;
                selectAll.checked = false;
            }
        }

        // 导出选中的代理
        async function exportSelected() {
            const checkedIds = document.querySelectorAll('input[name="proxyIds"]:checked');

            if (checkedIds.length === 0) {
                if (!confirm('未选择任何代理，将导出所有配置。确定继续吗？')) {
                    return;
                }
            }

            try {
                const formData = new FormData();
                if (checkedIds.length > 0) {
                    const ids = Array.from(checkedIds).map(cb => cb.value).join(',');
                    formData.append('ids', ids);
                }

                const response = await fetch('/proxy/export', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const error = await response.json();
                    alert('导出失败: ' + error.error);
                    return;
                }

                // 获取JSON数据并触发下载
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = 'proxies_export.json';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                a.remove();

                alert('导出成功！');
            } catch (error) {
                alert('导出出错: ' + error.message);
            }
        }

        // 显示导入对话框
        function showImportModal() {
            const modal = document.createElement('div');
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            `;

            modal.innerHTML = `
                <div style="background: white; padding: 30px; border-radius: 8px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                    <h2 style="margin: 0 0 20px 0; color: #333;">📥 导入代理配置</h2>
                    <p style="color: #666; margin-bottom: 20px;">从JSON配置文件导入代理配置</p>

                    <div style="margin-bottom: 20px;">
                        <label style="display: block; margin-bottom: 10px; font-weight: 600; color: #333;">选择JSON文件：</label>
                        <input type="file" id="importFile" accept=".json" style="width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px;">
                    </div>

                    <div style="background: #fff3cd; padding: 15px; border-radius: 6px; margin-bottom: 20px; border-left: 4px solid #ffc107;">
                        <p style="margin: 0; font-size: 14px; color: #856404;">
                            <strong>⚠️ 注意事项：</strong><br>
                            • 导入的代理将自动添加到系统中<br>
                            • 如果ID冲突，系统会自动分配新的ID<br>
                            • 导入后代理将自动启动
                        </p>
                    </div>

                    <div style="display: flex; gap: 10px; justify-content: flex-end;">
                        <button onclick="this.closest('div[style*=position]').remove()" style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">取消</button>
                        <button onclick="importConfig()" style="padding: 10px 20px; background: #6f42c1; color: white; border: none; border-radius: 4px; cursor: pointer;">📥 导入</button>
                    </div>
                </div>
            `;

            document.body.appendChild(modal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.remove();
                }
            });
        }

        // 执行导入操作
        async function importConfig() {
            const fileInput = document.getElementById('importFile');
            const file = fileInput.files[0];

            if (!file) {
                alert('请选择一个JSON文件');
                return;
            }

            try {
                const text = await file.text();
                const formData = new FormData();
                formData.append('config', text);

                const response = await fetch('/proxy/import', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (!response.ok) {
                    alert('导入失败: ' + result.error);
                    return;
                }

                alert(`导入成功！共导入 ${result.count} 个代理`);

                // 关闭对话框并刷新页面
                document.querySelector('div[style*="position: fixed"]').remove();
                location.reload();
            } catch (error) {
                alert('导入出错: ' + error.message);
            }
        }

        // 批量重启全部代理
        async function batchRestart() {
            if (!confirm('确定要重启所有代理吗？\n\n此操作会：\n• 停止所有运行的代理\n• 重新启动所有代理\n• 重新生成配置文件\n\n⚠️ 期间代理服务会短暂中断')) {
                return;
            }

            // 创建进度对话框
            const progressModal = showProgressModal('🔄 批量重启全部代理', [
                '停止所有代理...',
                '等待进程清理...',
                '重新生成配置文件...',
                '启动所有代理...',
                '完成！'
            ]);

            try {
                // 显示第一步
                updateProgressStep(progressModal, 0);

                const response = await fetch('/proxy/batch-restart', {
                    method: 'POST'
                });

                const result = await response.json();

                // 显示完成步骤
                updateProgressStep(progressModal, 4);

                if (!response.ok) {
                    hideProgressModal(progressModal);
                    alert('重启失败: ' + result.error);
                    return;
                }

                // 显示结果
                setTimeout(() => {
                    hideProgressModal(progressModal);
                    alert(`✅ 批量重启完成！\n\n成功重启: ${result.success} 个\n重启失败: ${result.failed} 个\n总代理数: ${result.total}\n\n${result.details && result.details.length > 0 ? '\n失败详情:\n' + result.details.join('\n') : ''}`);
                    location.reload();
                }, 500);

            } catch (error) {
                hideProgressModal(progressModal);
                alert('重启出错: ' + error.message);
            }
        }

        // 一键重建运行环境
        async function batchInit() {
            if (!confirm('确定要重建运行环境吗？\n\n此操作会：\n• 停止所有代理\n• 重新生成所有配置文件\n• 重新启动所有代理\n• 适合迁移到新服务器后使用\n\n⚠️ 如果代理正在运行，会先停止再启动')) {
                return;
            }

            // 创建进度对话框
            const progressModal = showProgressModal('🛠️ 一键重建运行环境', [
                '检查代理配置...',
                '停止所有代理...',
                '等待进程清理...',
                '重新生成配置文件...',
                '启动所有代理...',
                '完成！'
            ]);

            try {
                // 显示第一步
                updateProgressStep(progressModal, 0);

                const response = await fetch('/proxy/batch-init', {
                    method: 'POST'
                });

                const result = await response.json();

                // 显示完成步骤
                updateProgressStep(progressModal, 5);

                if (!response.ok) {
                    hideProgressModal(progressModal);
                    alert('重建失败: ' + result.error);
                    return;
                }

                // 显示结果
                setTimeout(() => {
                    hideProgressModal(progressModal);
                    let message = `✅ 一键重建完成！\n\n`;
                    message += `总代理数: ${result.total}\n`;
                    message += `重建成功: ${result.success} 个\n`;
                    message += `重建失败: ${result.failed} 个\n\n`;
                    message += `${result.details && result.details.length > 0 ? '失败详情:\n' + result.details.join('\n') + '\n\n' : ''}`;
                    message += `${result.warnings && result.warnings.length > 0 ? '⚠️ 警告��息:\n' + result.warnings.join('\n') : ''}`;
                    alert(message);
                    location.reload();
                }, 500);

            } catch (error) {
                hideProgressModal(progressModal);
                alert('重建出错: ' + error.message);
            }
        }

        // 显示进度对话框
        function showProgressModal(title, steps) {
            const modal = document.createElement('div');
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            `;

            modal.innerHTML = `
                <div style="background: white; padding: 40px; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 8px 40px rgba(0,0,0,0.4);">
                    <h2 style="margin: 0 0 30px 0; color: #333; font-size: 20px;">${title}</h2>
                    <div id="progressSteps" style="margin-bottom: 30px;"></div>
                    <div style="text-align: center; color: #666; font-size: 14px;">请稍候，正在执行中...</div>
                </div>
            `;

            // 渲染步骤
            const stepsDiv = modal.querySelector('#progressSteps');
            steps.forEach((step, index) => {
                const stepDiv = document.createElement('div');
                stepDiv.id = `progress-step-${index}`;
                stepDiv.style.cssText = `
                    display: flex;
                    align-items: center;
                    margin-bottom: 15px;
                    padding: 12px 15px;
                    border-radius: 8px;
                    background: #f8f9fa;
                    border-left: 4px solid #dee2e6;
                `;
                stepDiv.innerHTML = `
                    <span style="width: 24px; height: 24px; border-radius: 50%; background: #dee2e6; color: white; display: inline-flex; align-items: center; justify-content: center; margin-right: 15px; font-size: 12px; font-weight: bold;">${index + 1}</span>
                    <span style="color: #666;">${step}</span>
                `;
                stepsDiv.appendChild(stepDiv);
            });

            document.body.appendChild(modal);
            return modal;
        }

        // 更新进度步骤
        function updateProgressStep(modal, stepIndex) {
            const stepDiv = modal.querySelector(`#progress-step-${stepIndex}`);
            if (stepDiv) {
                stepDiv.style.background = '#e3f2fd';
                stepDiv.style.borderLeftColor = '#2196f3';
                stepDiv.querySelector('span:first-child').style.background = '#2196f3';
            }

            // 隐藏进度步骤并显示完成状态
            if (stepIndex >= 0) {
                const allSteps = modal.querySelectorAll('[id^="progress-step-"]');
                allSteps.forEach((step, index) => {
                    if (index < stepIndex) {
                        step.style.background = '#e8f5e9';
                        step.style.borderLeftColor = '#4caf50';
                        step.querySelector('span:first-child').style.background = '#4caf50';
                        step.querySelector('span:first-child').innerHTML = '✓';
                    } else if (index === stepIndex) {
                        step.style.background = '#fff3e0';
                        step.style.borderLeftColor = '#ff9800';
                        step.querySelector('span:first-child').style.background = '#ff9800';
                    }
                });
            }
        }

        // 隐藏进度对话框
        function hideProgressModal(modal) {
            modal.remove();
        }

        // 测试出站连接
        async function testOutbound(id) {
            const testBtn = document.getElementById('test-btn-' + id);
            const latencyEl = document.getElementById('latency-' + id);

            // 显示测试中状态
            latencyEl.textContent = '测试中...';
            latencyEl.className = 'latency testing';
            testBtn.textContent = '测试中';
            testBtn.style.opacity = '0.6';
            testBtn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/test/' + id);
                const result = await response.json();

                if (result.success) {
                    // 更新RTT列
                    latencyEl.textContent = result.rtt;

                    // 根据延迟设置颜色
                    const ms = result.latency / 1000000; // 纳秒转毫秒
                    if (ms < 100) {
                        latencyEl.className = 'latency good';
                    } else if (ms < 300) {
                        latencyEl.className = 'latency medium';
                    } else {
                        latencyEl.className = 'latency bad';
                    }
                } else {
                    // 更新RTT列显示失败
                    latencyEl.textContent = '失败';
                    latencyEl.className = 'latency bad';
                }
            } catch (error) {
                // 更新RTT列显示错误
                latencyEl.textContent = '错误';
                latencyEl.className = 'latency bad';
            } finally {
                // 恢复按钮状态
                testBtn.textContent = '测试';
                testBtn.style.opacity = '1';
                testBtn.style.pointerEvents = 'auto';
            }
        }

        // 重启单个代理 (AJAX)
        async function restartProxy(id, name) {
            if (!confirm(`确定要重启代理 "${name}" 吗？\n\n此操作会重新从数据库读取配置并重建连接。`)) {
                return;
            }

            const btn = document.getElementById('restart-btn-' + id);
            const originalText = btn.textContent;
            btn.textContent = '⏳ 重启中...';
            btn.style.opacity = '0.6';
            btn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/restart/' + id, { method: 'POST' });
                const result = await response.json();

                if (response.ok && result.success) {
                    alert(`✅ 代理 "${name}" 重启成功！`);
                    location.reload();
                } else {
                    alert(`❌ 重启失败: ${result.error || '未知错误'}`);
                }
            } catch (error) {
                alert('❌ 网络错误: ' + error.message);
            } finally {
                btn.textContent = originalText;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
            }
        }

        // 启动/停止代理 (AJAX)
        async function toggleProxy(id, name, action) {
            const actionName = action === 'stop' ? '停止' : '启动';
            if (!confirm(`确定要${actionName}代理 "${name}" 吗？`)) {
                return;
            }

            const btn = document.getElementById('toggle-btn-' + id);
            const originalText = btn.textContent;
            btn.textContent = `⏳ ${actionName}中...`;
            btn.style.opacity = '0.6';
            btn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/toggle/' + id, { method: 'GET' });

                if (response.ok || response.redirected) {
                    alert(`✅ 代理 "${name}" ${actionName}成功！`);
                    location.reload();
                } else {
                    const text = await response.text();
                    alert(`❌ ${actionName}失败: ${text}`);
                }
            } catch (error) {
                alert('❌ 网络错误: ' + error.message);
            } finally {
                btn.textContent = originalText;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
            }
        }

        // 删除代理 (AJAX)
        async function deleteProxy(id, name) {
            if (!confirm(`确定要删除代理 "${name}" 吗？\n\n⚠️ 此操作不可恢复！\n• 配置文件将被删除\n• 数据库记录将被删除`)) {
                return;
            }

            const btn = document.getElementById('delete-btn-' + id);
            const originalText = btn.textContent;
            btn.textContent = '⏳ 删除中...';
            btn.style.opacity = '0.6';
            btn.style.pointerEvents = 'none';

            try {
                const response = await fetch('/proxy/delete/' + id, { method: 'GET' });

                if (response.ok || response.redirected) {
                    alert(`✅ 代理 "${name}" 已删除！`);
                    location.reload();
                } else {
                    const text = await response.text();
                    alert(`❌ 删除失败: ${text}`);
                }
            } catch (error) {
                alert('❌ 网络错误: ' + error.message);
            } finally {
                btn.textContent = originalText;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
            }
        }

    </script>

    <footer style="text-align: center; margin-top: 40px; padding: 20px 0; color: #6c757d; border-top: 1px solid #dee2e6;">
        <p style="margin: 0; font-size: 14px;">goForward {{.version}} | 高性能端口转发工具</p>
    </footer>
</body>
</html>
