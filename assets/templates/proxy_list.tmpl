        function formatElapsedSeconds(seconds) {
            if (seconds < 60) {
                return `${seconds}s`;
            }
            const minutes = Math.floor(seconds / 60);
            const remain = seconds % 60;
            return `${minutes}m${remain}s`;
        }

        function parseImportPayload(text) {
            const trimmed = text.trim();
            if (!trimmed) {
                return { error: '配置文件为空' };
            }

            const parseJson = (input) => {
                try {
                    return { value: JSON.parse(input) };
                } catch (error) {
                    return { error };
                }
            };

            let result = parseJson(trimmed);
            if (!result.error) {
                return result;
            }

            const firstObject = trimmed.indexOf('{');
            const firstArray = trimmed.indexOf('[');
            let start = -1;
            if (firstObject >= 0 && firstArray >= 0) {
                start = Math.min(firstObject, firstArray);
            } else {
                start = Math.max(firstObject, firstArray);
            }
            const end = Math.max(trimmed.lastIndexOf('}'), trimmed.lastIndexOf(']'));
            if (start >= 0 && end > start) {
                result = parseJson(trimmed.slice(start, end + 1));
                if (!result.error) {
                    return result;
                }
            }

            return { error: result.error?.message || '配置文件不是有效的JSON' };
        }

        async function readJsonResponse(response) {
            const text = await response.text();
            if (!text) {
                return { data: null, text: '' };
            }
            try {
                return { data: JSON.parse(text), text };
            } catch (error) {
                return { error, text };
            }
        }

        // 执行导入操作
        let importInProgress = false;
        async function importConfig() {
            if (importInProgress) {
                return;
            }

            const fileInput = document.getElementById('importFile');
            const file = fileInput.files[0];

            if (!file) {
                alert('请选择一个JSON文件');
                return;
            }

            importInProgress = true;
            closeImportModal();

            const progressModal = showProgressModal('📥 正在导入代理配置', [
                '读取配置文件...',
                '上传配置数据...',
                '服务器处理中...',
                '导入完成'
            ]);
            updateProgressStep(progressModal, 0);
            setProgressStatus(progressModal, '正在读取文件...');

            const startTime = Date.now();
            const elapsedTimer = setInterval(() => {
                const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
                setProgressElapsed(progressModal, `已等待 ${formatElapsedSeconds(elapsedSeconds)}`);
            }, 1000);

            try {
                const text = await file.text();
                const parsed = parseImportPayload(text);
                if (parsed.error) {
                    throw new Error(`配置文件解析失败: ${parsed.error}`);
                }
                let payload = parsed.value;
                if (Array.isArray(payload)) {
                    payload = { version: '1.0', proxies: payload };
                }

                const formData = new FormData();
                formData.append('config', JSON.stringify(payload));

                updateProgressStep(progressModal, 1);
                setProgressStatus(progressModal, '正在上传配置数据...');

                const response = await fetch('/proxy/import/async', {
                    method: 'POST',
                    body: formData
                });

                const parsedResponse = await readJsonResponse(response);
                if (response.status === 404) {
                    updateProgressStep(progressModal, 2);
                    setProgressStatus(progressModal, '异步接口不可用，改用同步导入...');

                    const fallbackResponse = await fetch('/proxy/import', {
                        method: 'POST',
                        body: formData
                    });
                    const fallbackParsed = await readJsonResponse(fallbackResponse);
                    if (fallbackParsed.error) {
                        throw new Error(fallbackParsed.text.trim() || '导入失败');
                    }
                    if (!fallbackResponse.ok) {
                        throw new Error((fallbackParsed.data && fallbackParsed.data.error) || '导入失败');
                    }

                    updateProgressStep(progressModal, 3);
                    setProgressStatus(progressModal, '导入完成');
                    clearInterval(elapsedTimer);
                    importInProgress = false;
                    hideProgressModal(progressModal);
                    alert(`导入成功！共导入 ${fallbackParsed.data.count || 0} 个代理`);
                    location.reload();
                    return;
                }

                if (parsedResponse.error) {
                    throw new Error(parsedResponse.text.trim() || '导入接口返回非JSON');
                }

                const result = parsedResponse.data || {};

                if (!response.ok) {
                    throw new Error(result.error || '导入启动失败');
                }

                if (!result.jobId) {
                    throw new Error('导入任务创建失败');
                }

                updateProgressStep(progressModal, 2);
                setProgressStatus(progressModal, '服务器正在导入，请稍候...');

                await pollImportStatus(result.jobId, progressModal);

                clearInterval(elapsedTimer);
                importInProgress = false;
            } catch (error) {
                importInProgress = false;
                clearInterval(elapsedTimer);
                hideProgressModal(progressModal);
                alert('导入出错: ' + error.message);
            }
        }

        async function pollImportStatus(jobId, progressModal) {
            let attempts = 0;
            while (true) {
                let response;
                let result;

                try {
                    response = await fetch(`/proxy/import/status/${jobId}`);
                    result = await response.json();
                } catch (error) {
                    attempts++;
                    setProgressStatus(progressModal, '状态获取失败，正在重试...');
                    await new Promise(resolve => setTimeout(resolve, 1200));
                    if (attempts > 5) {
                        throw new Error('状态获取失败，请稍后刷新页面查看结果');
                    }
                    continue;
                }

                if (!response.ok) {
                    throw new Error(result.error || '状态获取失败');
                }

                attempts = 0;

                if (result.status === 'queued' || result.status === 'running') {
                    const total = result.total || 0;
                    const imported = result.imported || 0;
                    const failed = result.failed || 0;

                    if (total > 0) {
                        const failureText = failed > 0 ? `，失败 ${failed}` : '';
                        setProgressStatus(progressModal, `服务器导入中：${imported}/${total}${failureText}`);
                    } else {
                        setProgressStatus(progressModal, '服务器正在导入，请稍候...');
                    }

                    await new Promise(resolve => setTimeout(resolve, 1200));
                    continue;
                }

                updateProgressStep(progressModal, 3);

                if (result.status === 'failed') {
                    hideProgressModal(progressModal);
                    throw new Error(result.error || '导入失败');
                }

                const total = result.total || result.imported || 0;
                const imported = result.imported || 0;
                const failed = result.failed || 0;
                let message = `导入完成！成功导入 ${imported} 个代理`;
                if (failed > 0) {
                    message += `，失败 ${failed} 个`;
                }
                if (total > 0 && total !== imported + failed) {
                    message += `（总计 ${total} 个）`;
                }

                hideProgressModal(progressModal);
                alert(message);
                location.reload();
                return;
            }
        }

        // 批量重启全部代理
        async function batchRestart() {
