        async function submitRemoteInstall(event) {
            event.preventDefault();

            const host = document.getElementById('remote-host').value.trim();
            const port = document.getElementById('remote-port').value || '22';
            const user = document.getElementById('remote-user').value.trim();
            const password = document.getElementById('remote-password').value;
            const hy2Port = document.getElementById('remote-hy2-port').value || '443';
            const nodeName = document.getElementById('remote-node-name').value.trim();

            if (!host || !user || !password) {
                alert('请填写必填字段');
                return false;
            }

            // 显示进度
            document.getElementById('remote-install-progress').style.display = 'block';
            document.getElementById('remote-install-submit').disabled = true;
            document.getElementById('remote-install-submit').textContent = '安装中...';

            const statusEl = document.getElementById('remote-install-status');
            statusEl.textContent = '正在连接服务器...';

            try {
                const response = await fetch('/proxy/remote-install', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        host: host,
                        port: parseInt(port),
                        user: user,
                        password: password,
                        hy2Port: parseInt(hy2Port),
                        nodeName: nodeName
                    })
                });

                const result = await response.json();

                if (result.success) {
                    statusEl.textContent = '✅ 安装成功！';
                    document.getElementById('remote-install-progress').querySelector('div').style.background = '#e8f5e9';
                    document.getElementById('remote-install-progress').querySelector('div').style.borderLeftColor = '#4caf50';
                    statusEl.style.color = '#2e7d32';

                    setTimeout(() => {
                        closeRemoteInstallModal();
                        alert(`✅ Hysteria2 安装成功！\n\n节点名称: ${result.nodeName}\n服务器: ${host}:${hy2Port}\n\n节点已添加到列表中。`);
                        location.reload();
                    }, 1000);
                } else {
                    throw new Error(result.error || '安装失败');
                }
            } catch (error) {
                statusEl.textContent = '❌ ' + error.message;
                document.getElementById('remote-install-progress').querySelector('div').style.background = '#ffebee';
                document.getElementById('remote-install-progress').querySelector('div').style.borderLeftColor = '#f44336';
                statusEl.style.color = '#c62828';

                document.getElementById('remote-install-submit').disabled = false;
                document.getElementById('remote-install-submit').textContent = '🚀 重试安装';
            }

            return false;
        }

