        async function loadOutboundList() {
            const tbody = document.getElementById('outbound-tbody');
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 40px; color: #666;">加载中...</td></tr>';

            try {
                const response = await fetch('/outbound/list');
                const data = await response.json();

                if (data.code !== 0) {
                    throw new Error(data.error || '加载失败');
                }

                outboundList = data.data || [];
                renderOutboundTable();
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 40px; color: #dc3545;">❌ ${error.message}</td></tr>`;
            }
        }

        function renderOutboundTable() {
            const tbody = document.getElementById('outbound-tbody');

            if (!outboundList.length) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 40px; color: #666;">暂无落地配置，点击上方按钮添加</td></tr>';
                return;
            }

            tbody.innerHTML = outboundList.map(item => {
                const typeLabels = { hysteria2: 'Hysteria2', socks5: 'SOCKS5', vmess: 'VMess' };
                const typeColors = { hysteria2: '#007bff', socks5: '#ffc107', vmess: '#17a2b8' };

                let serverInfo = '';
                if (item.type === 'hysteria2') {
                    serverInfo = `${item.hy2Server}:${item.hy2Port}`;
                } else if (item.type === 'socks5') {
                    serverInfo = `${item.socks5Addr}:${item.socks5Port}`;
                } else if (item.type === 'vmess') {
                    serverInfo = `${item.vmessServer}:${item.vmessPort}`;
                }

                return `
                    <tr>
                        <td style="padding: 12px; border-bottom: 1px solid #eee; font-weight: 600;">${item.name}</td>
                        <td style="padding: 12px; border-bottom: 1px solid #eee;">
                            <span style="background: ${typeColors[item.type]}; color: white; padding: 3px 10px; border-radius: 12px; font-size: 12px;">${typeLabels[item.type]}</span>
                        </td>
                        <td style="padding: 12px; border-bottom: 1px solid #eee; font-family: monospace; color: #666;">${serverInfo}</td>
                        <td style="padding: 12px; border-bottom: 1px solid #eee; text-align: center;">
                            <a href="javascript:void(0)" onclick="editOutbound(${item.id})" class="btn-primary" style="padding: 4px 10px; font-size: 12px; border-radius: 4px; text-decoration: none; margin-left: 5px;">编辑</a>
                            <a href="javascript:void(0)" onclick="deleteOutbound(${item.id}, '${item.name}')" class="btn-danger" style="padding: 4px 10px; font-size: 12px; border-radius: 4px; text-decoration: none; margin-left: 5px;">删除</a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function editOutbound(id) {
            const item = outboundList.find(o => o.id === id);
            if (!item) return;

            document.getElementById('outbound-list-container').style.display = 'none';
            document.getElementById('outbound-form-container').style.display = 'block';

            document.getElementById('outbound-id').value = item.id;
            document.getElementById('outbound-name').value = item.name;
            document.getElementById('outbound-type').value = item.type;

            // 填充对应类型的配置
            if (item.type === 'hysteria2') {
                document.getElementById('outbound-hy2-server').value = item.hy2Server || '';
                document.getElementById('outbound-hy2-port').value = item.hy2Port || '443';
                document.getElementById('outbound-hy2-password').value = item.hy2Password || '';
                document.getElementById('outbound-hy2-sni').value = item.hy2SNI || '';
                document.getElementById('outbound-hy2-up').value = item.hy2UpMbps || 100;
                document.getElementById('outbound-hy2-down').value = item.hy2DownMbps || 100;
                document.getElementById('outbound-hy2-insecure').checked = item.hy2Insecure;
            } else if (item.type === 'socks5') {
                document.getElementById('outbound-socks5-addr').value = item.socks5Addr || '';
                document.getElementById('outbound-socks5-port').value = item.socks5Port || 1080;
                document.getElementById('outbound-socks5-user').value = item.socks5User || '';
                document.getElementById('outbound-socks5-password').value = item.socks5Password || '';
            } else if (item.type === 'vmess') {
                document.getElementById('outbound-vmess-server').value = item.vmessServer || '';
                document.getElementById('outbound-vmess-port').value = item.vmessPort || 443;
                document.getElementById('outbound-vmess-uuid').value = item.vmessUUID || '';
                document.getElementById('outbound-vmess-network').value = item.vmessNetwork || 'tcp';
                document.getElementById('outbound-vmess-security').value = item.vmessSecurity || 'auto';
                document.getElementById('outbound-vmess-tls').value = item.vmessTLS ? '1' : '0';
            }

            toggleOutboundTypeForm();
        }

        async function deleteOutbound(id, name) {
            if (!confirm(`确定要删除落地配置 "${name}" 吗？`)) {
                return;
            }

            try {
                const response = await fetch(`/outbound/delete/${id}`, { method: 'POST' });
                const data = await response.json();

                if (data.code !== 0) {
                    throw new Error(data.error || '删除失败');
                }

                alert('✅ 落地配置已删除');
                loadOutboundList();
            } catch (error) {
                alert('❌ ' + error.message);
            }
        }

        // 落地配置表单提交
        document.addEventListener('DOMContentLoaded', () => {
            const outboundForm = document.getElementById('outbound-form');
            if (outboundForm) {
                outboundForm.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    const formData = new FormData(outboundForm);
                    const id = formData.get('id');
                    const url = id ? `/outbound/update/${id}` : '/outbound/add';

                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            body: formData
                        });
                        const data = await response.json();

                        if (data.code !== 0 && !data.id) {
                            throw new Error(data.error || '保存失败');
                        }

                        alert('✅ 落地配置已保存');
                        showOutboundList();
                        loadOutboundList();
                    } catch (error) {
                        alert('❌ ' + error.message);
                    }
                });
            }
        });

    </script>

    <footer style="text-align: center; margin-top: 40px; padding: 20px 0; color: #6c757d; border-top: 1px solid #dee2e6;">
        <p style="margin: 0; font-size: 14px;">goForward {{.version}} | 高性能端口转发工具</p>
    </footer>
</body>
</html>
