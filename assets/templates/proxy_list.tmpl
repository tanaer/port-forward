        async function executeRestart(type) {
            if (!currentRestartProxyId) return;

            const progressDiv = document.getElementById('restart-progress');
            const statusEl = document.getElementById('restart-status');

            progressDiv.style.display = 'block';

            if (type === 'local') {
                statusEl.textContent = '正在重启本地代理...';
                try {
                    const response = await fetch('/proxy/restart/' + currentRestartProxyId, { method: 'POST' });
                    const result = await response.json();

                    if (response.ok && result.success) {
                        statusEl.textContent = '✅ 本地代理重启成功！';
                        setTimeout(() => {
                            closeRestartModal();
                            location.reload();
                        }, 1000);
                    } else {
                        statusEl.textContent = '❌ 重启失败: ' + (result.error || '未知错误');
                        statusEl.style.color = '#dc3545';
                    }
                } catch (error) {
                    statusEl.textContent = '❌ 网络错误: ' + error.message;
                    statusEl.style.color = '#dc3545';
                }
            } else if (type === 'remote') {
                statusEl.textContent = '正在SSH连接远程服务器...';
                try {
                    const response = await fetch('/proxy/remote-restart', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ proxyId: currentRestartProxyId })
                    });
                    const result = await response.json();

                    if (result.success) {
                        statusEl.textContent = '✅ 远程Hysteria2服务重启成功！';
                        setTimeout(() => {
                            closeRestartModal();
                        }, 1500);
                    } else {
                        statusEl.textContent = '❌ 远程重启失败: ' + (result.error || '未知错误');
                        statusEl.style.color = '#dc3545';
                    }
                } catch (error) {
                    statusEl.textContent = '❌ 网络错误: ' + error.message;
                    statusEl.style.color = '#dc3545';
                }
            }
        }

