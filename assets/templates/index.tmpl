<!-- templates/index.html -->
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forward</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: auto;
            max-width: 960px;
            background-color: #f8f9fa;
            font-size: 16px;
            padding: 20px;
        }

        h2 {
            color: #343a40;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #dee2e6;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #2181b5;
            color: #fff;
        }

        .but {
            display: inline-block;
            color: white;
            background-color: #28a745;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
            text-decoration-line: none;
            text-align: center;
            min-width: 48px;
        }

        form {
            margin-top: 20px;
        }

        input,
        textarea,
        select,
        button {
            margin-bottom: 10px;
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #495057;
        }

        .protocol-options {
            display: flex;
            gap: 16px;
            margin-bottom: 10px;
        }

        .protocol-options label {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .but.edit {
            background-color: #6c757d;
        }

        .toolbar {
            display: flex;
            gap: 12px;
            margin: 12px 0;
        }

        .toolbar button {
            padding: 8px 16px;
            border: none;
            background-color: #2181b5;
            color: #fff;
            cursor: pointer;
        }

        .toolbar button.secondary {
            background-color: #6c757d;
        }

        .send {
            border: none;
            color: white;
            background-color: #2181b5;
        }
    </style>
</head>

<body>
    <h2>转发列表</h2>
    <div class="toolbar">
        <button type="button" id="copySelected">复制选中</button>
        <button type="button" id="copyAll">复制全部</button>
        <button type="button" class="secondary" id="importClipboard">导入剪切板</button>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAll"></th>
                    <th>ID</th>
                    <th>本地端口</th>
                    <th>远程地址</th>
                    <th>远程端口</th>
                    <th>空闲时长</th>
                    <th>类型</th>
                    <th>流量</th>
                    <th>备注</th>
                    <th>IP白名单</th>
                    <th>IP黑名单</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{range $index, $item := .forwardList}}
                <tr>
                    <td><input type="checkbox" class="row-select" data-index="{{$index}}"></td>
                    <td>{{.Id}}</td>
                    <td>{{.LocalPort}}</td>
                    <td>{{.RemoteAddr}}</td>
                    <td>{{.RemotePort}}</td>
                    <td>{{.OutTime}}s</td>
                    <td>{{.Protocol}}</td>
                    <td>{{if gt .TotalGigabyte 0}}{{.TotalGigabyte}}G{{end}} {{.TolBytes}} </td>
                    <td>{{.Remark}}</td>
                    <td>{{.Whitelist}}</td>
                    <td>{{.Blacklist}}</td>
                    <td>
                        <div class="actions">
                            <a class="but edit" href="/edit/{{.Id}}">编辑</a>
                            <a class="but" style="background-color: #{{if eq .Status 0}}d93b3b{{else}}2181b5{{end}};" href="/do/{{.Id}}">{{if eq .Status 0}}停用{{else}}启用{{end}}</a>
                            <a class="but" href="/del/{{.Id}}">删除</a>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <h2>添加转发</h2>
    <form action="/add" method="post" id="addForm">
        <input type="text" name="localPort" placeholder="本地端口" required>
        <input type="text" name="remotePort" placeholder="远程端口" required>
        <input type="text" name="remoteAddr" placeholder="远程地址" required>
        <input type="number" name="outTime" placeholder="超时时间" required>
        <input type="text" name="remark" placeholder="备注 (可选)">
        
        <label>类型:</label>
        <div class="protocol-options">
            <label><input type="checkbox" name="protocol" value="tcp" checked>TCP</label>
            <label><input type="checkbox" name="protocol" value="udp">UDP</label>
        </div>
        
        <label for="protocol">IP白名单:</label>
        <textarea name="whitelist"  cols="30" rows="5" placeholder="192.168.1.0/25;192.168.5.221"></textarea>
        <label for="protocol">IP黑名单:</label>
        <textarea name="blacklist"  cols="30" rows="5" placeholder="192.168.1.0/25;"></textarea>
        
        
        <input class="send" type="submit" value="添加" />
    </form>
    <script>
    const forwardList = {{ toJSON .forwardList }};

    const selectAll = document.getElementById('selectAll');
    const rowCheckboxes = Array.from(document.querySelectorAll('.row-select'));

    selectAll.addEventListener('change', () => {
        rowCheckboxes.forEach(cb => cb.checked = selectAll.checked);
    });

    document.getElementById('addForm').addEventListener('submit', function (event) {
        const selected = document.querySelectorAll('input[name="protocol"]:checked');
        if (!selected.length) {
            alert('请至少选择一种协议类型');
            event.preventDefault();
        }
    });

    function collectSelectedIndexes(all = false) {
        if (all) {
            return forwardList.map((_, idx) => idx);
        }
        return rowCheckboxes.filter(cb => cb.checked).map(cb => parseInt(cb.dataset.index, 10));
    }

    function buildPayload(indexes) {
        return indexes.map(idx => {
            const item = forwardList[idx];
            return {
                localPort: item.LocalPort,
                remotePort: item.RemotePort,
                remoteAddr: item.RemoteAddr,
                outTime: item.OutTime,
                protocol: item.Protocol,
                whitelist: item.Whitelist,
                blacklist: item.Blacklist,
                remark: item.Remark
            };
        });
    }

    async function copyToClipboard(data) {
        const text = JSON.stringify(data, null, 2);
        await navigator.clipboard.writeText(text);
        alert('已复制到剪切板');
    }

    document.getElementById('copySelected').addEventListener('click', async () => {
        const indexes = collectSelectedIndexes(false);
        if (!indexes.length) {
            alert('请先选择需要复制的线路');
            return;
        }
        await copyToClipboard(buildPayload(indexes));
    });

    document.getElementById('copyAll').addEventListener('click', async () => {
        if (!forwardList.length) {
            alert('没有可复制的线路');
            return;
        }
        await copyToClipboard(buildPayload(collectSelectedIndexes(true)));
    });

    async function importFromClipboard() {
        try {
            const text = await navigator.clipboard.readText();
            if (!text) {
                alert('剪切板为空');
                return;
            }
            let payload;
            try {
                payload = JSON.parse(text);
            } catch (e) {
                alert('剪切板内容不是有效的JSON');
                return;
            }
            if (!Array.isArray(payload)) {
                alert('剪切板内容格式不正确，需要数组');
                return;
            }
            const res = await fetch('/import', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ forwards: payload })
            });
            const result = await res.json();
            alert(result.msg || '导入完成');
            if (result.suc) {
                location.reload();
            }
        } catch (err) {
            alert('导入失败: ' + err.message);
        }
    }

    document.getElementById('importClipboard').addEventListener('click', importFromClipboard);
    </script>
</body>
</html>
