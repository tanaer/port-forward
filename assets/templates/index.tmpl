<!-- templates/index.html -->
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forward</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: auto;
            max-width: 960px;
            background-color: #f8f9fa;
            font-size: 16px;
            padding: 20px;
        }

        h2 {
            color: #343a40;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #dee2e6;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #2181b5;
            color: #fff;
        }

        .but-container {
            display: flex;
            gap: 10px;
            /* 设置按钮之间的间隔 */
        }

        .but {
            display: inline-block;
            color: white;
            background-color: #28a745;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
            text-decoration-line: none;
            text-align: center;
            min-width: 48px;
        }

        form {
            margin-top: 20px;
        }

        input,
        textarea,
        select,
        button {
            margin-bottom: 10px;
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #495057;
        }

        .protocol-options {
            display: flex;
            gap: 16px;
            margin-bottom: 10px;
        }

        .protocol-options label {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .but.edit {
            background-color: #6c757d;
        }

        .send {
            border: none;
            color: white;
            background-color: #2181b5;
        }
    </style>
</head>

<body>
    <h2>转发列表</h2>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>本地端口</th>
                    <th>远程地址</th>
                    <th>远程端口</th>
                    <th>空闲时长</th>
                    <th>类型</th>
                    <th>流量</th>
                    <th>IP白名单</th>
                    <th>IP黑名单</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{range .forwardList}}
                <tr>
                    <td>{{.Id}}</td>
                    <td>{{.LocalPort}}</td>
                    <td>{{.RemoteAddr}}</td>
                    <td>{{.RemotePort}}</td>
                    <td>{{.OutTime}}s</td>
                    <td>{{.Protocol}}</td>
                    <td>{{if gt .TotalGigabyte 0}}{{.TotalGigabyte}}G{{end}} {{.TolBytes}} </td>
                    
                    <td>{{.Whitelist}}</td>
                    <td>{{.Blacklist}}</td>
                    <td>
                        <div class="actions">
                            <a class="but edit" href="/edit/{{.Id}}">编辑</a>
                            <a class="but" style="background-color: #{{if eq .Status 0}}d93b3b{{else}}2181b5{{end}};" href="/do/{{.Id}}">{{if eq .Status 0}}停用{{else}}启用{{end}}</a>
                            <a class="but" href="/del/{{.Id}}">删除</a>
                        </div>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <h2>添加转发</h2>
    <form action="/add" method="post" id="addForm">
        <input type="text" name="localPort" placeholder="本地端口" required>
        <input type="text" name="remotePort" placeholder="远程端口" required>
        <input type="text" name="remoteAddr" placeholder="远程地址" required>
        <input type="number" name="outTime" placeholder="超时时间" required>
        
        <label>类型:</label>
        <div class="protocol-options">
            <label><input type="checkbox" name="protocol" value="tcp" checked>TCP</label>
            <label><input type="checkbox" name="protocol" value="udp">UDP</label>
        </div>
        
        <label for="protocol">IP白名单:</label>
        <textarea name="whitelist"  cols="30" rows="5" placeholder="192.168.1.0/25;192.168.5.221"></textarea>
        <label for="protocol">IP黑名单:</label>
        <textarea name="blacklist"  cols="30" rows="5" placeholder="192.168.1.0/25;"></textarea>
        
        
        <input class="send" type="submit" value="添加" />
    </form>
    <script>
    document.getElementById('addForm').addEventListener('submit', function (event) {
        const selected = document.querySelectorAll('input[name="protocol"]:checked');
        if (!selected.length) {
            alert('请至少选择一种协议类型');
            event.preventDefault();
        }
    });
    </script>
</body>
</html>
